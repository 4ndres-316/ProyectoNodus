<Window
  x:Class="Proyecto_Boletos.vistas.NuevoClienteDialog"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="Registrar Nuevo Cliente"
  SizeToContent="Height"
  Width="460"
  MinHeight="400"
  WindowStartupLocation="CenterOwner"
  ResizeMode="CanResizeWithGrip"
  Icon="/Logo_Nodus.png"
  Background="{DynamicResource Color3}"
>
  <StackPanel Margin="28">

    <TextBlock Text="Nuevo Cliente" FontSize="20" FontWeight="Bold"
               Foreground="{DynamicResource Color1}" Margin="0,0,0,20" />

    <TextBlock Text="Nombre completo *" FontSize="11" Foreground="#555" Margin="0,0,0,4" />
    <TextBox x:Name="txtNombre" Padding="8,7" Margin="0,0,0,14" FontSize="13" />

    <TextBlock Text="Username *" FontSize="11" Foreground="#555" Margin="0,0,0,4" />
    <TextBox x:Name="txtUsername" Padding="8,7" Margin="0,0,0,14" FontSize="13" />

    <TextBlock Text="Correo electronico" FontSize="11" Foreground="#555" Margin="0,0,0,4" />
    <TextBox x:Name="txtCorreo" Padding="8,7" Margin="0,0,0,14" FontSize="13" />

    <TextBlock Text="Telefono" FontSize="11" Foreground="#555" Margin="0,0,0,4" />
    <TextBox x:Name="txtTelefono" Padding="8,7" Margin="0,0,0,14" FontSize="13" />

    <TextBlock Text="Contrasena *" FontSize="11" Foreground="#555" Margin="0,0,0,4" />
    <PasswordBox x:Name="pbPassword" Padding="8,7" FontSize="13" Margin="0,0,0,4" />
    <TextBlock Text="Se guardara encriptada. El cliente la usara para entrar a la app movil."
               FontSize="10" Foreground="#888" TextWrapping="Wrap" Margin="0,0,0,24" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Cancelar" Width="100" Height="36" Margin="0,0,10,0"
              IsCancel="True" Background="White" Foreground="{DynamicResource Color1}"
              BorderBrush="{DynamicResource Color1}" Cursor="Hand"
              Click="btnCancelar_Click" />
      <Button Content="Registrar Cliente" Width="150" Height="36"
              Background="{DynamicResource Color1}" Foreground="White"
              BorderBrush="{DynamicResource Color1}" FontWeight="SemiBold"
              Cursor="Hand" Click="btnRegistrar_Click" />
    </StackPanel>

  </StackPanel>
</Window>

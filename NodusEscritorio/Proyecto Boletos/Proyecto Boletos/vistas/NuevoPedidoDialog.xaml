<Window
  x:Class="Proyecto_Boletos.vistas.NuevoPedidoDialog"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="Crear Evento para Cliente"
  Height="760"
  Width="1060"
  WindowStartupLocation="CenterOwner"
  ResizeMode="NoResize"
  Icon="/Logo_Nodus.png"
  Background="{DynamicResource Color3}"
  Loaded="Window_Loaded"
>
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="12" />
      <ColumnDefinition Width="300" />
    </Grid.ColumnDefinitions>

    <!-- TITULOS -->
    <TextBlock
      Grid.Row="0"
      Grid.Column="0"
      Text="Crear Evento para Cliente"
      FontSize="20"
      FontWeight="Bold"
      Foreground="{DynamicResource Color1}"
      Margin="0,0,0,10"
    />
    <TextBlock
      Grid.Row="0"
      Grid.Column="2"
      Text="Carrito del Evento"
      FontSize="20"
      FontWeight="Bold"
      Foreground="{DynamicResource Color1}"
      Margin="0,0,0,10"
    />

    <!-- DETALLES DEL EVENTO -->
    <Border
      Grid.Row="1"
      Grid.Column="0"
      Grid.ColumnSpan="3"
      BorderBrush="{DynamicResource Color1}"
      BorderThickness="1"
      CornerRadius="6"
      Background="White"
      Padding="14,10"
      Margin="0,0,0,10"
    >
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*" />
          <ColumnDefinition Width="10" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="6" />
          <ColumnDefinition Width="68" />
          <ColumnDefinition Width="10" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="6" />
          <ColumnDefinition Width="68" />
          <ColumnDefinition Width="10" />
          <ColumnDefinition Width="80" />
          <ColumnDefinition Width="10" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
          <TextBlock Text="Nombre del evento *" FontSize="11" Foreground="#555" Margin="0,0,0,3" />
          <TextBox x:Name="txtNombreEvento" Padding="6,5" />
        </StackPanel>

        <StackPanel Grid.Column="2">
          <TextBlock Text="Fecha inicio *" FontSize="11" Foreground="#555" Margin="0,0,0,3" />
          <DatePicker x:Name="dpFechaInicio" />
        </StackPanel>

        <StackPanel Grid.Column="4">
          <TextBlock Text="Hora inicio" FontSize="11" Foreground="#555" Margin="0,0,0,3" />
          <TextBox x:Name="txtHoraInicio" Text="08:00" Padding="4,5" TextAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Column="6">
          <TextBlock Text="Fecha fin *" FontSize="11" Foreground="#555" Margin="0,0,0,3" />
          <DatePicker x:Name="dpFechaFin" />
        </StackPanel>

        <StackPanel Grid.Column="8">
          <TextBlock Text="Hora fin" FontSize="11" Foreground="#555" Margin="0,0,0,3" />
          <TextBox x:Name="txtHoraFin" Text="18:00" Padding="4,5" TextAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Column="10">
          <TextBlock Text="Max. inv." FontSize="11" Foreground="#555" Margin="0,0,0,3" />
          <TextBox x:Name="txtMaxInvitados" Text="0" Padding="4,5" TextAlignment="Center" />
        </StackPanel>

        <CheckBox
          Grid.Column="12"
          x:Name="chkEsPublico"
          Content="Publico"
          VerticalAlignment="Center"
          Margin="0,4,0,0"
          FontSize="12"
          Checked="chkEsPublico_Checked"
        />
      </Grid>
    </Border>

    <!-- TABS: Recinto | Servicios | Invitados -->
    <TabControl Grid.Row="2" Grid.Column="0" x:Name="tabPrincipal">
      <!-- TAB RECINTO -->
      <TabItem Header="  Recinto  " x:Name="tabRecinto">
        <Border
          BorderBrush="{DynamicResource Color1}"
          BorderThickness="1"
          CornerRadius="0,6,6,6"
          Background="White"
        >
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{DynamicResource Color1}" Padding="14,8">
              <TextBlock
                Foreground="White"
                FontSize="12"
                Text="Selecciona el recinto donde se realizara el evento. Ingresa las horas abajo."
              />
            </Border>
            <ListView x:Name="lvRecintos" Grid.Row="1" BorderThickness="0" Background="Transparent">
              <ListView.View>
                <GridView>
                  <GridViewColumn
                    Header="Nombre"
                    Width="200"
                    DisplayMemberBinding="{Binding NombreRecinto}"
                  />
                  <GridViewColumn
                    Header="Tipo"
                    Width="110"
                    DisplayMemberBinding="{Binding TipoRecinto}"
                  />
                  <GridViewColumn
                    Header="Capacidad"
                    Width="80"
                    DisplayMemberBinding="{Binding Capacidad}"
                  />
                  <GridViewColumn
                    Header="Precio / hr"
                    Width="100"
                    DisplayMemberBinding="{Binding PrecioFormateado}"
                  />
                  <GridViewColumn Header="" Width="140">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <Button
                          Content="Seleccionar recinto"
                          Tag="{Binding}"
                          Height="26"
                          Padding="6,0"
                          FontSize="11"
                          Background="{DynamicResource Color1}"
                          Foreground="White"
                          BorderBrush="{DynamicResource Color1}"
                          Cursor="Hand"
                          Click="btnSeleccionarRecinto_Click"
                        />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                </GridView>
              </ListView.View>
            </ListView>
          </Grid>
        </Border>
      </TabItem>

      <!-- TAB SERVICIOS -->
      <TabItem Header="  Servicios de Proveedores  " x:Name="tabServicios">
        <Border
          BorderBrush="{DynamicResource Color1}"
          BorderThickness="1"
          CornerRadius="0,6,6,6"
          Background="White"
          ClipToBounds="True"
        >
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="175" />
              <ColumnDefinition Width="1" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="42" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border
              Grid.Column="0"
              Grid.Row="0"
              Background="{DynamicResource Color1}"
              Padding="12,0"
            >
              <TextBlock
                Text="Proveedores"
                Foreground="White"
                FontWeight="SemiBold"
                FontSize="13"
                VerticalAlignment="Center"
              />
            </Border>
            <Border
              Grid.Column="2"
              Grid.Row="0"
              Background="{DynamicResource Color1}"
              Padding="10,6"
            >
              <TextBox
                x:Name="txtBuscarServicio"
                Padding="6,4"
                VerticalAlignment="Center"
                TextChanged="txtBuscarServicio_TextChanged"
              />
            </Border>
            <Rectangle
              Grid.Column="1"
              Grid.Row="0"
              Grid.RowSpan="2"
              Fill="{DynamicResource Color1}"
            />

            <ListBox
              x:Name="lbProveedores"
              Grid.Column="0"
              Grid.Row="1"
              BorderThickness="0"
              Background="Transparent"
              SelectionChanged="lbProveedores_SelectionChanged"
            >
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                  <Setter Property="Padding" Value="12,9" />
                  <Setter Property="FontSize" Value="12" />
                  <Setter Property="Cursor" Value="Hand" />
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                  <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter Property="Background" Value="{DynamicResource Color2}" />
                      <Setter Property="FontWeight" Value="SemiBold" />
                    </Trigger>
                  </Style.Triggers>
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Nombre}" TextWrapping="Wrap" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <ListView
              x:Name="lvCatalogo"
              Grid.Column="2"
              Grid.Row="1"
              BorderThickness="0"
              Background="Transparent"
              SelectionMode="Single"
            >
              <ListView.View>
                <GridView>
                  <GridViewColumn
                    Header="Servicio"
                    Width="125"
                    DisplayMemberBinding="{Binding NombreServicio}"
                  />
                  <GridViewColumn
                    Header="Item / Descripcion"
                    Width="175"
                    DisplayMemberBinding="{Binding NombreItem}"
                  />
                  <GridViewColumn
                    Header="Precio"
                    Width="85"
                    DisplayMemberBinding="{Binding PrecioFormateado}"
                  />
                  <GridViewColumn Header="" Width="125">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <Button
                          Content="+ Agregar al carrito"
                          Tag="{Binding}"
                          Height="26"
                          Padding="6,0"
                          FontSize="11"
                          Background="{DynamicResource Color1}"
                          Foreground="White"
                          BorderBrush="{DynamicResource Color1}"
                          Cursor="Hand"
                          Click="btnAgregarItem_Click"
                        />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                </GridView>
              </ListView.View>
            </ListView>
          </Grid>
        </Border>
      </TabItem>

      <!-- TAB INVITADOS -->
      <TabItem Header="  Invitados  " x:Name="tabInvitados">
        <Border
          BorderBrush="{DynamicResource Color1}"
          BorderThickness="1"
          CornerRadius="0,6,6,6"
          Background="White"
        >
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Formulario agregar invitado -->
            <Border Grid.Row="0" Background="{DynamicResource Color1}" Padding="12,8">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition Width="150" />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                  x:Name="txtNombreInvitado"
                  Padding="6,4"
                  VerticalAlignment="Center"
                  Background="White"
                />
                <ComboBox
                  x:Name="cmbTipoInvitado"
                  Grid.Column="2"
                  VerticalAlignment="Center"
                  Height="30"
                  SelectedIndex="0"
                >
                  <ComboBoxItem Content="General" />
                  <ComboBoxItem Content="VIP" />
                  <ComboBoxItem Content="Staff" />
                  <ComboBoxItem Content="Prensa" />
                </ComboBox>
                <Button
                  Grid.Column="4"
                  Content="+ Agregar invitado"
                  Height="30"
                  Padding="12,0"
                  Background="White"
                  Foreground="{DynamicResource Color1}"
                  BorderBrush="White"
                  FontWeight="SemiBold"
                  Cursor="Hand"
                  Click="btnAgregarInvitado_Click"
                />
              </Grid>
            </Border>

            <!-- Lista de invitados -->
            <ListView
              x:Name="lvInvitados"
              Grid.Row="1"
              BorderThickness="0"
              Background="Transparent"
            >
              <ListView.View>
                <GridView>
                  <GridViewColumn
                    Header="Nombre del Invitado"
                    Width="350"
                    DisplayMemberBinding="{Binding Nombre}"
                  />
                  <GridViewColumn Header="Tipo" Width="120" DisplayMemberBinding="{Binding Tipo}" />
                  <GridViewColumn Header="" Width="90">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <Button
                          Content="Quitar"
                          Tag="{Binding}"
                          Height="24"
                          Padding="6,0"
                          FontSize="11"
                          Background="#F44336"
                          Foreground="White"
                          BorderBrush="#F44336"
                          Cursor="Hand"
                          Click="btnQuitarInvitado_Click"
                        />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                </GridView>
              </ListView.View>
            </ListView>

            <!-- Contador -->
            <Border Grid.Row="2" BorderBrush="#EEEEEE" BorderThickness="0,1,0,0" Padding="14,8">
              <TextBlock
                x:Name="txtContadorInvitados"
                FontSize="12"
                Foreground="#555"
                Text="0 invitados agregados. Usa el campo 'Max. inv.' arriba para el limite."
              />
            </Border>
          </Grid>
        </Border>
      </TabItem>

      <!-- TAB BOLETOS -->
      <TabItem Header="  Boletos  " x:Name="tabBoletos" Visibility="Hidden">
        <Border
          BorderBrush="{DynamicResource Color1}"
          BorderThickness="1"
          CornerRadius="0,6,6,6"
          Background="White"
        >
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Formulario agregar boleto -->
            <Border Grid.Row="0" Background="{DynamicResource Color1}" Padding="12,8">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition Width="220" />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                  x:Name="txtNombreBoleto"
                  Padding="6,4"
                  VerticalAlignment="Center"
                  Background="White"
                />
                <TextBox
                  x:Name="txtPrecio"
                  Padding="6,4"
                  Grid.Column="2"
                  VerticalAlignment="Center"
                  Background="White"
                />

                <Button
                  Grid.Column="4"
                  Content="+ Agregar Boleto"
                  Height="30"
                  Padding="12,0"
                  Background="White"
                  Foreground="{DynamicResource Color1}"
                  BorderBrush="White"
                  FontWeight="SemiBold"
                  Cursor="Hand"
                />
              </Grid>
            </Border>

            <!-- Lista de boletos -->
            <ListView x:Name="lvBoletos" Grid.Row="1" BorderThickness="0" Background="Transparent">
              <ListView.View>
                <GridView>
                  <GridViewColumn
                    Header="Tipo Boleto"
                    Width="350"
                    DisplayMemberBinding="{Binding Nombre}"
                  />
                  <GridViewColumn
                    Header="Precio"
                    Width="150"
                    DisplayMemberBinding="{Binding Tipo}"
                  />
                  <GridViewColumn Header="" Width="90">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <Button
                          Content="Quitar"
                          Tag="{Binding}"
                          Height="24"
                          Padding="6,0"
                          FontSize="11"
                          Background="#F44336"
                          Foreground="White"
                          BorderBrush="#F44336"
                          Cursor="Hand"
                        />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                </GridView>
              </ListView.View>
            </ListView>
          </Grid>
        </Border>
      </TabItem>
    </TabControl>

    <!-- CARRITO -->
    <Border
      Grid.Row="2"
      Grid.Column="2"
      BorderBrush="{DynamicResource Color1}"
      BorderThickness="1"
      CornerRadius="6"
      Background="White"
    >
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ListView x:Name="lvCarrito" Grid.Row="0" BorderThickness="0" Background="Transparent">
          <ListView.View>
            <GridView>
              <GridViewColumn
                Header="Item"
                Width="138"
                DisplayMemberBinding="{Binding NombreServicio}"
              />
              <GridViewColumn Header="Cant." Width="36" DisplayMemberBinding="{Binding Cantidad}" />
              <GridViewColumn
                Header="Total"
                Width="82"
                DisplayMemberBinding="{Binding SubtotalFormateado}"
              />
            </GridView>
          </ListView.View>
        </ListView>
        <Border Grid.Row="1" BorderBrush="#EEEEEE" BorderThickness="0,1,0,0" Padding="10">
          <StackPanel>
            <Grid Margin="0,0,0,5">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Items en carrito:" FontSize="12" Foreground="#555" />
              <TextBlock
                Grid.Column="1"
                x:Name="txtCantItems"
                Text="0 items"
                FontSize="12"
                Foreground="#555"
              />
            </Grid>
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Subtotal:" FontWeight="Bold" FontSize="14" />
              <TextBlock
                Grid.Column="1"
                x:Name="txtSubtotalCarrito"
                Text="Bs 0.00"
                FontWeight="Bold"
                FontSize="14"
                Foreground="{DynamicResource Color1}"
              />
            </Grid>
            <Button
              x:Name="btnQuitarItem"
              Content="Quitar seleccionado"
              Height="30"
              Background="#F44336"
              Foreground="White"
              BorderBrush="#F44336"
              Margin="0,0,0,6"
              Click="btnQuitarItem_Click"
            />
            <Button
              x:Name="btnProcederPago"
              Content="Confirmar Evento y Pagar"
              Height="36"
              Background="{DynamicResource Color1}"
              Foreground="White"
              BorderBrush="{DynamicResource Color1}"
              FontWeight="SemiBold"
              Click="btnProcederPago_Click"
            />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <!-- FOOTER -->
    <Border
      Grid.Row="3"
      Grid.Column="0"
      Grid.ColumnSpan="3"
      BorderBrush="#EEEEEE"
      BorderThickness="0,1,0,0"
      Padding="0,10,0,0"
      Margin="0,10,0,0"
    >
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="8" />
          <ColumnDefinition Width="23" />
        </Grid.ColumnDefinitions>
        <TextBlock
          Text="Imagen de Evento: "
          Grid.Column="0"
          VerticalAlignment="Center"
          Foreground="{DynamicResource Color4}"
          FontSize="12"
          Margin="0,0,5,0"
        />
        <TextBox
          x:Name="txtImagen"
          Grid.Column="1"
          Height="32"
          Padding="4"
          VerticalContentAlignment="Center"
        />
        <TextBox
          x:Name="txtCantidad"
          Grid.Column="3"
          Text="1"
          Height="32"
          Padding="4"
          TextAlignment="Center"
          VerticalContentAlignment="Center"
          IsEnabled="False"
        />
      </Grid>
    </Border>
  </Grid>
</Window>

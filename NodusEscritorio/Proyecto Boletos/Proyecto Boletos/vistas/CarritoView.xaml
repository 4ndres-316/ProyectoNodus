<UserControl
  x:Class="Proyecto_Boletos.vistas.CarritoView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  mc:Ignorable="d"
  d:DesignHeight="600"
  d:DesignWidth="900"
  Loaded="UserControl_Loaded"
>
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- TÍTULO -->
    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
      <TextBlock
        Text="Carrito"
        FontSize="24"
        FontWeight="Bold"
        Foreground="{DynamicResource Color1}"
      />
      <TextBlock
        FontFamily="Segoe MDL2 Assets"
        Text="&#xE7BF;"
        FontSize="24"
        FontWeight="Bold"
        Foreground="{DynamicResource Color1}"
        Margin="10,5,0,0"
      />
    </StackPanel>

    <!-- NAVEGACIÓN TABS -->
    <Border
      Grid.Row="1"
      BorderBrush="{DynamicResource Color1}"
      BorderThickness="1"
      CornerRadius="5"
      Padding="10"
      Background="{DynamicResource Color3}"
      Margin="0,0,0,16"
    >
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Button
          x:Name="btnBoletos"
          Grid.Column="0"
          Content="🎟 Boletos"
          Height="36"
          Margin="0,0,5,0"
          Background="{DynamicResource Color1}"
          Foreground="White"
          BorderBrush="{DynamicResource Color1}"
          Click="btnBoletos_Click"
        />
        <Button
          x:Name="btnEspera"
          Grid.Column="1"
          Content="⏳ En Espera"
          Height="36"
          Margin="5,0,5,0"
          Background="{DynamicResource Color3}"
          Foreground="{DynamicResource Color1}"
          BorderBrush="{DynamicResource Color1}"
          Click="btnEspera_Click"
        />
        <Button
          x:Name="btnHistorial"
          Grid.Column="2"
          Content="📋 Mis Compras"
          Height="36"
          Margin="5,0,0,0"
          Background="{DynamicResource Color3}"
          Foreground="{DynamicResource Color1}"
          BorderBrush="{DynamicResource Color1}"
          Click="btnHistorial_Click"
        />
      </Grid>
    </Border>

    <!-- PANEL BOLETOS (Cards) -->
    <Border
      x:Name="panelBoletos"
      Grid.Row="2"
      BorderBrush="{DynamicResource Color1}"
      BorderThickness="1"
      CornerRadius="5"
    >
      <Grid>
        <!-- Cards -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
          <WrapPanel x:Name="wpBoletos" Orientation="Horizontal" />
        </ScrollViewer>

        <!-- Sin resultados -->
        <TextBlock
          x:Name="txtSinBoletos"
          Text="No hay eventos públicos con boletos disponibles."
          FontSize="14"
          Foreground="#999"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Visibility="Collapsed"
        />

        <!-- Cargando -->
        <TextBlock
          x:Name="txtCargandoBoletos"
          Text="Cargando eventos..."
          FontSize="14"
          Foreground="#999"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
        />
      </Grid>
    </Border>

    <!-- PANEL EN ESPERA (Lista pendientes) -->
    <Border
      x:Name="panelEspera"
      Grid.Row="2"
      BorderBrush="{DynamicResource Color1}"
      BorderThickness="1"
      CornerRadius="5"
      Visibility="Collapsed"
    >
      <Grid>
        <DataGrid
          x:Name="dgEspera"
          Style="{StaticResource ModernDataGridStyle}"
          AutoGenerateColumns="False"
          IsReadOnly="True"
          CanUserAddRows="False"
          SelectionMode="Single"
        />
        <TextBlock
          x:Name="txtSinEspera"
          Text="No hay compras pendientes de pago."
          FontSize="14"
          Foreground="#999"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Visibility="Collapsed"
        />
      </Grid>
    </Border>

    <!-- PANEL MIS COMPRAS (Historial) -->
    <Border
      x:Name="panelHistorial"
      Grid.Row="2"
      BorderBrush="{DynamicResource Color1}"
      BorderThickness="1"
      CornerRadius="5"
      Visibility="Collapsed"
    >
      <Grid>
        <DataGrid
          x:Name="dgHistorial"
          Style="{StaticResource ModernDataGridStyle}"
          AutoGenerateColumns="False"
          IsReadOnly="True"
          CanUserAddRows="False"
          SelectionMode="Single"
        />
        <TextBlock
          x:Name="txtSinHistorial"
          Text="No tienes compras registradas."
          FontSize="14"
          Foreground="#999"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Visibility="Collapsed"
        />
        <TextBlock
          x:Name="txtCargandoHistorial"
          Text="Cargando historial..."
          FontSize="14"
          Foreground="#999"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Visibility="Collapsed"
        />
      </Grid>
    </Border>
  </Grid>
</UserControl>

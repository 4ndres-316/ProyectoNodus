<UserControl
  x:Class="Proyecto_Boletos.vistas.ProveedoresView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  mc:Ignorable="d"
  d:DesignHeight="550"
  d:DesignWidth="850"
>
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="auto" />
      <RowDefinition Height="2*" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- HEADER -->
    <!-- TÍTULO -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Orientation="Horizontal" Margin="0 0 0 20">
        <TextBlock
          Text="Directorio de Proveedores"
          FontSize="24"
          FontWeight="Bold"
          Foreground="{DynamicResource Color1}"
        />
        <TextBlock
          FontFamily="Segoe MDL2 Assets"
          Text="&#xE8AB;"
          FontSize="24"
          FontWeight="Bold"
          Foreground="{DynamicResource Color1}"
          Margin="10 5 0 0"
        />
      </StackPanel>

      <!-- Botones superiores -->
      <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0 0 0 20">
        <Button
          x:Name="btnNuevo"
          Content="Nuevo"
          Width="100"
          Height="35"
          Margin="5,0"
          Background="{DynamicResource Color1}"
          Foreground="White"
          BorderBrush="{DynamicResource Color1}"
          Click="btnNuevo_Click"
        />
        <Button
          x:Name="btnGuardar"
          Content="Guardar"
          Width="100"
          Height="35"
          Margin="5,0"
          Background="{DynamicResource Color1}"
          Foreground="White"
          BorderBrush="{DynamicResource Color1}"
          IsEnabled="False"
          Click="btnGuardar_Click"
        />
        <Button
          x:Name="btnCancelar"
          Content="Cancelar"
          Width="100"
          Height="35"
          Margin="5,0"
          Background="{DynamicResource Color2}"
          Foreground="White"
          BorderBrush="{DynamicResource Color2}"
          IsEnabled="False"
          Click="btnCancelar_Click"
        />
      </StackPanel>
    </Grid>

    <!-- Buscador -->
    <Border
      x:Name="buscador"
      Background="White"
      Grid.Row="1"
      Margin="0 0 0 20"
      BorderBrush="#CCCCCC"
      BorderThickness="1"
      CornerRadius="20"
    >
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="40" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock
          FontFamily="Segoe MDL2 Assets"
          Text="&#xE71E;"
          FontSize="20"
          Background="Transparent"
          VerticalAlignment="Center"
          HorizontalAlignment="Center"
        />
        <TextBox
          x:Name="txtBuscar"
          Grid.Column="1"
          Background="Transparent"
          BorderThickness="0"
          VerticalContentAlignment="Center"
          Margin="5 7"
        />
      </Grid>
    </Border>

    <!-- DATAGRID -->
    <Border
      Grid.Row="2"
      BorderBrush="{DynamicResource Color1}"
      BorderThickness="1"
      CornerRadius="5"
      Margin="0,0,0,20"
    >
      <DataGrid x:Name="dgProveedores" Style="{StaticResource ModernDataGridStyle}">
        <!-- COLUMNAS -->
        <DataGrid.Columns>
          <DataGridTextColumn
            Header="NIT"
            Binding="{Binding NitProveedor}"
            Width="120"
            ElementStyle="{StaticResource TextoCentrado}"
          />

          <DataGridTextColumn
            Header="Nombre Comercial"
            Binding="{Binding NombreComercial}"
            Width="*"
            ElementStyle="{StaticResource TextoCentrado}"
          />

          <DataGridTextColumn
            Header="Teléfono"
            Binding="{Binding TelefonoComercial}"
            Width="150"
            ElementStyle="{StaticResource TextoCentrado}"
          />

          <DataGridTextColumn
            Header="Ciudad"
            Binding="{Binding IdCiudad}"
            Width="80"
            ElementStyle="{StaticResource TextoCentrado}"
          />

          <DataGridTextColumn
            Header="Estado"
            Binding="{Binding EstadoProveedor}"
            Width="120"
            ElementStyle="{StaticResource TextoCentrado}"
          />
          <DataGridTemplateColumn Header="Opciones" Width="160">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                  <Button
                    Content="Editar"
                    Width="65"
                    Height="26"
                    Margin="3,0"
                    Background="{DynamicResource Color1}"
                    Foreground="White"
                    BorderBrush="{DynamicResource Color1}"
                    Tag="{Binding}"
                    Click="btnEditar_Click"
                  />
                  <Button
                    Content="Eliminar"
                    Height="26"
                    Margin="3,0"
                    Background="#F44336"
                    Foreground="White"
                    BorderBrush="#F44336"
                    Tag="{Binding}"
                    Click="btnEliminar_Click"
                  />
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </Border>

    <!-- FORMULARIO -->
    <Border
      Grid.Row="3"
      BorderBrush="{DynamicResource Color1}"
      BorderThickness="1"
      CornerRadius="5"
      Padding="10"
      Background="{DynamicResource Color3}"
    >
      <ScrollViewer VerticalScrollBarVisibility="Hidden">
        <!-- CAMPOS -->
        <Grid x:Name="campos" Grid.Row="0" IsEnabled="False">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <!-- COLUMNA 1 -->
          <StackPanel Grid.Column="0" Margin="0,0,10,0">
            <TextBlock Text="NIT Proveedor:" Margin="0,5" Foreground="{DynamicResource Color4}" />

            <TextBox x:Name="txtNitProveedor" Padding="5" Margin="0,0,0,10" />

            <TextBlock
              Text="Nombre Comercial:"
              Margin="0,5"
              Foreground="{DynamicResource Color4}"
            />

            <TextBox x:Name="txtNombreComercial" Padding="5" Margin="0,0,0,10" />
          </StackPanel>

          <!-- COLUMNA 2 -->
          <StackPanel Grid.Column="1" Margin="10,0">
            <TextBlock
              Text="Teléfono Comercial:"
              Margin="0,5"
              Foreground="{DynamicResource Color4}"
            />

            <TextBox x:Name="txtTelefonoComercial" Padding="5" Margin="0,0,0,10" />

            <TextBlock Text="Ciudad:" Margin="0,5" Foreground="{DynamicResource Color4}" />

            <ComboBox
              x:Name="cmbCiudad"
              Padding="5"
              Margin="0,0,0,10"
              DisplayMemberPath="NombreCiudad"
              SelectedValuePath="IdCiudad"
            />
          </StackPanel>

          <!-- COLUMNA 3 -->
          <StackPanel Grid.Column="2" Margin="10,0,0,0">
            <TextBlock
              Text="Estado Proveedor:"
              Margin="0,5"
              Foreground="{DynamicResource Color4}"
            />

            <ComboBox x:Name="cmbEstadoProveedor" Padding="5" Margin="0,0,0,10">
              <ComboBoxItem Content="Activo" IsSelected="True" />

              <ComboBoxItem Content="Inactivo" />
            </ComboBox>
          </StackPanel>
        </Grid>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>

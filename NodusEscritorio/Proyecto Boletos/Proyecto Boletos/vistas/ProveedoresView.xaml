<UserControl
  x:Class="Proyecto_Boletos.vistas.ProveedoresView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  mc:Ignorable="d"
  d:DesignHeight="650"
  d:DesignWidth="950"
>
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- TÍTULO -->
    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
      <TextBlock Text="Proveedores y Servicios" FontSize="26" FontWeight="Bold"
                 Foreground="{DynamicResource Color1}" />
      <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8AB;" FontSize="22"
                 Foreground="{DynamicResource Color1}" Margin="10,5,0,0" />
    </StackPanel>

    <TabControl Grid.Row="1" BorderThickness="0" Background="Transparent">

      <!-- ═══════════════════════════════════════════ -->
      <!-- TAB 1 — CATÁLOGO DE SERVICIOS              -->
      <!-- ═══════════════════════════════════════════ -->
      <TabItem Header="Catálogo de Servicios" FontSize="13">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <Border Margin="0,12,0,12" Background="White" BorderBrush="#CCCCCC"
                  BorderThickness="1" CornerRadius="20">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE71E;" FontSize="18"
                         VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="Gray" />
              <TextBox x:Name="txtBuscarCatalogo" Grid.Column="1" Background="Transparent"
                       BorderThickness="0" VerticalContentAlignment="Center" Margin="5,7" FontSize="13" />
            </Grid>
          </Border>

          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden">
            <StackPanel x:Name="panelCatalogo" Margin="0,4,4,0" />
          </ScrollViewer>
        </Grid>
      </TabItem>

      <!-- ═══════════════════════════════════════════ -->
      <!-- TAB 2 — GESTIONAR PROVEEDORES              -->
      <!-- ═══════════════════════════════════════════ -->
      <TabItem Header="Gestionar Proveedores" FontSize="13">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- Botones -->
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,8">
            <Button x:Name="btnNuevo"    Content="Nuevo"    Width="100" Height="35" Margin="5,0"
                    Background="{DynamicResource Color1}" Foreground="White"
                    BorderBrush="{DynamicResource Color1}" Click="btnNuevo_Click" />
            <Button x:Name="btnGuardar"  Content="Guardar"  Width="100" Height="35" Margin="5,0"
                    Background="{DynamicResource Color1}" Foreground="White"
                    BorderBrush="{DynamicResource Color1}" IsEnabled="False" Click="btnGuardar_Click" />
            <Button x:Name="btnCancelar" Content="Cancelar" Width="100" Height="35" Margin="5,0"
                    Background="{DynamicResource Color2}" Foreground="White"
                    BorderBrush="{DynamicResource Color2}" IsEnabled="False" Click="btnCancelar_Click" />
          </StackPanel>

          <!-- Buscador -->
          <Border Grid.Row="1" Margin="0,0,0,10" Background="White" BorderBrush="#CCCCCC"
                  BorderThickness="1" CornerRadius="20">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE71E;" FontSize="18"
                         VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="Gray" />
              <TextBox x:Name="txtBuscar" Grid.Column="1" Background="Transparent"
                       BorderThickness="0" VerticalContentAlignment="Center" Margin="5,7" FontSize="13" />
            </Grid>
          </Border>

          <!-- DataGrid -->
          <Border Grid.Row="2" BorderBrush="{DynamicResource Color1}"
                  BorderThickness="1" CornerRadius="5" Margin="0,0,0,10">
            <DataGrid x:Name="dgProveedores" Style="{StaticResource ModernDataGridStyle}">
              <DataGrid.Columns>
                <DataGridTextColumn Header="NIT"             Binding="{Binding NitProveedor}"      Width="120" ElementStyle="{StaticResource TextoCentrado}" />
                <DataGridTextColumn Header="Nombre Comercial" Binding="{Binding NombreComercial}"  Width="*"   ElementStyle="{StaticResource TextoCentrado}" />
                <DataGridTextColumn Header="Teléfono"        Binding="{Binding TelefonoComercial}" Width="110" ElementStyle="{StaticResource TextoCentrado}" />
                <DataGridTextColumn Header="Ciudad"          Binding="{Binding NombreCiudad}"      Width="100" ElementStyle="{StaticResource TextoCentrado}" />
                <DataGridTextColumn Header="Servicios"       Binding="{Binding ServiciosConPrecio}" Width="*"  ElementStyle="{StaticResource TextoCentrado}" />
                <DataGridTextColumn Header="Estado"          Binding="{Binding EstadoProveedor}"   Width="85"  ElementStyle="{StaticResource TextoCentrado}" />
                <DataGridTemplateColumn Header="Opciones" Width="155">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Editar" Width="65" Height="26" Margin="3,0"
                                Background="{DynamicResource Color1}" Foreground="White"
                                BorderBrush="{DynamicResource Color1}" Tag="{Binding}" Click="btnEditar_Click" />
                        <Button Content="Deshabilitar" Height="26" Margin="3,0"
                                Background="#F44336" Foreground="White"
                                BorderBrush="#F44336" Tag="{Binding}" Click="btnDeshabilitar_Click" />
                      </StackPanel>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
          </Border>

          <!-- FORMULARIO -->
          <Border Grid.Row="3" BorderBrush="{DynamicResource Color1}" BorderThickness="1"
                  CornerRadius="5" Padding="12" Background="{DynamicResource Color3}"
                  MaxHeight="280">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel x:Name="campos" IsEnabled="False">

                <!-- Campos básicos -->
                <Grid Margin="0,0,0,10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>

                  <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="NIT Proveedor:" Margin="0,4" Foreground="{DynamicResource Color4}" />
                    <TextBox x:Name="txtNitProveedor" Padding="5" Margin="0,0,0,8" />
                    <TextBlock Text="Nombre Comercial:" Margin="0,4" Foreground="{DynamicResource Color4}" />
                    <TextBox x:Name="txtNombreComercial" Padding="5" />
                  </StackPanel>

                  <StackPanel Grid.Column="1" Margin="10,0">
                    <TextBlock Text="Teléfono Comercial:" Margin="0,4" Foreground="{DynamicResource Color4}" />
                    <TextBox x:Name="txtTelefonoComercial" Padding="5" Margin="0,0,0,8" />
                    <TextBlock Text="Ciudad:" Margin="0,4" Foreground="{DynamicResource Color4}" />
                    <ComboBox x:Name="cmbCiudad" Padding="5"
                              DisplayMemberPath="NombreCiudad" SelectedValuePath="IdCiudad" />
                  </StackPanel>

                  <StackPanel Grid.Column="2" Margin="10,0,0,0">
                    <TextBlock Text="Estado:" Margin="0,4" Foreground="{DynamicResource Color4}" />
                    <ComboBox x:Name="cmbEstadoProveedor" Padding="5">
                      <ComboBoxItem Content="Activo" IsSelected="True" />
                      <ComboBoxItem Content="Inactivo" />
                    </ComboBox>
                  </StackPanel>
                </Grid>

                <!-- Sección servicios dinámicos -->
                <Border BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Margin="0,4,0,8" />

                <Grid Margin="0,0,0,6">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Servicios que ofrece:" FontWeight="SemiBold"
                             Foreground="{DynamicResource Color4}" VerticalAlignment="Center" />
                  <Button x:Name="btnAgregarServicioForm" Grid.Column="1"
                          Content="+ Agregar Servicio" Height="28" Padding="10,0"
                          Background="{DynamicResource Color1}" Foreground="White"
                          BorderBrush="{DynamicResource Color1}"
                          Click="btnAgregarServicioForm_Click" />
                </Grid>

                <StackPanel x:Name="panelServiciosProveedor" Margin="0,0,0,4" />

              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>
      </TabItem>

      <!-- ═══════════════════════════════════════════ -->
      <!-- TAB 3 — RESUMEN DE PROVEEDORES             -->
      <!-- ═══════════════════════════════════════════ -->
      <TabItem Header="Resumen de Proveedores" FontSize="13">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <!-- Tarjetas de conteo -->
          <StackPanel Orientation="Horizontal" Margin="0,12,0,10">
            <Border Padding="16,10" CornerRadius="8" Margin="0,0,10,0"
                    BorderThickness="1" BorderBrush="{DynamicResource Color1}" Background="White">
              <StackPanel>
                <TextBlock Text="Total Proveedores" FontSize="12" Foreground="Gray" />
                <TextBlock x:Name="txtTotalProveedores" Text="0" FontSize="30"
                           FontWeight="Bold" Foreground="{DynamicResource Color1}" />
              </StackPanel>
            </Border>
            <Border Padding="16,10" CornerRadius="8" Margin="0,0,10,0"
                    BorderThickness="1" BorderBrush="#4CAF50" Background="White">
              <StackPanel>
                <TextBlock Text="Activos" FontSize="12" Foreground="Gray" />
                <TextBlock x:Name="txtProveedoresActivos" Text="0" FontSize="30"
                           FontWeight="Bold" Foreground="#4CAF50" />
              </StackPanel>
            </Border>
            <Border Padding="16,10" CornerRadius="8"
                    BorderThickness="1" BorderBrush="#F44336" Background="White">
              <StackPanel>
                <TextBlock Text="Inactivos" FontSize="12" Foreground="Gray" />
                <TextBlock x:Name="txtProveedoresInactivos" Text="0" FontSize="30"
                           FontWeight="Bold" Foreground="#F44336" />
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- Buscador resumen -->
          <Border Grid.Row="1" Margin="0,0,0,10" Background="White" BorderBrush="#CCCCCC"
                  BorderThickness="1" CornerRadius="20">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE71E;" FontSize="18"
                         VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="Gray" />
              <TextBox x:Name="txtBuscarResumen" Grid.Column="1" Background="Transparent"
                       BorderThickness="0" VerticalContentAlignment="Center" Margin="5,7" FontSize="13" />
            </Grid>
          </Border>

          <!-- Tarjetas de proveedores -->
          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <WrapPanel x:Name="panelResumen" Margin="0,4,4,0"
                       Orientation="Horizontal" />
          </ScrollViewer>
        </Grid>
      </TabItem>

    </TabControl>
  </Grid>
</UserControl>

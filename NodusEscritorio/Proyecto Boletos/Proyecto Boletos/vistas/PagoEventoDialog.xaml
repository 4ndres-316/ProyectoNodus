<Window
  x:Class="Proyecto_Boletos.vistas.PagoEventoDialog"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="Confirmar Reserva"
  Height="450"
  Width="400"
  WindowStartupLocation="CenterOwner"
  ResizeMode="NoResize"
>
  <Grid Margin="25">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock
      Grid.Row="0"
      Text="¿Desea realizar el pago ahora?"
      FontSize="16"
      FontWeight="Bold"
      Margin="0,0,0,15"
      Foreground="{DynamicResource Color1}"
    />

    <StackPanel Grid.Row="1" Margin="0,0,0,12">
      <TextBlock Text="Método de Pago" FontWeight="SemiBold" Margin="0,0,0,4" />
      <ComboBox
        x:Name="cmbMetodoPago"
        Padding="6,5"
        DisplayMemberPath="Nombre"
        SelectedValuePath="IdMetodoPago"
      />
    </StackPanel>

    <StackPanel Grid.Row="2" Margin="0,0,0,12">
      <TextBlock Text="Monto" FontWeight="SemiBold" Margin="0,0,0,4" />
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="50" />
        </Grid.ColumnDefinitions>
        <TextBox x:Name="txtMonto" Padding="6,5" />
        <TextBlock
          Grid.Column="1"
          Text="Bs"
          VerticalAlignment="Center"
          HorizontalAlignment="Center"
          FontWeight="SemiBold"
        />
      </Grid>
    </StackPanel>

    <StackPanel Grid.Row="3" Margin="0,0,0,12">
      <TextBlock Text="Nota (Opcional)" FontWeight="SemiBold" Margin="0,0,0,4" />
      <TextBox
        x:Name="txtNota"
        Height="70"
        Padding="6,5"
        TextWrapping="Wrap"
        AcceptsReturn="True"
      />
    </StackPanel>

    <StackPanel Grid.Row="4" Margin="0,0,0,12">
      <TextBlock Text="Referencia / Comprobante" FontWeight="SemiBold" Margin="0,0,0,4" />
      <TextBox x:Name="txtReferencia" Padding="6,5" />
    </StackPanel>

    <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button
        Content="Sin pago por ahora"
        x:Name="btnSinPago"
        Width="150"
        Height="36"
        Margin="0,0,8,0"
        Background="{DynamicResource Color2}"
        Foreground="White"
        BorderBrush="{DynamicResource Color2}"
        Click="btnSinPago_Click"
      />
      <Button
        Content="Confirmar Pago"
        x:Name="btnConfirmar"
        Width="130"
        Height="36"
        Background="{DynamicResource Color1}"
        Foreground="White"
        BorderBrush="{DynamicResource Color1}"
        Click="btnConfirmar_Click"
      />
    </StackPanel>
  </Grid>
</Window>

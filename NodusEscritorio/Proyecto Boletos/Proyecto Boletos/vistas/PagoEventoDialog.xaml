<Window
  x:Class="Proyecto_Boletos.vistas.PagoEventoDialog"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="Confirmar Pago"
  Height="700"
  Width="540"
  WindowStartupLocation="CenterOwner"
  ResizeMode="NoResize"
  Icon="/Logo_Nodus.png"
  Background="{DynamicResource Color3}"
>
  <ScrollViewer VerticalScrollBarVisibility="Hidden">
    <Grid Margin="22">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <TextBlock Grid.Row="0" Text="Confirmar Pedido" FontSize="18" FontWeight="Bold"
                 Margin="0,0,0,14" Foreground="{DynamicResource Color1}" />

      <!-- Desglose -->
      <Border Grid.Row="1" BorderBrush="{DynamicResource Color1}" BorderThickness="1"
              CornerRadius="6" Padding="12" Margin="0,0,0,12" Background="White">
        <StackPanel>
          <TextBlock Text="Detalle del Pedido" FontWeight="Bold" FontSize="13"
                     Foreground="{DynamicResource Color1}" Margin="0,0,0,8" />
          <ListView x:Name="lvDesglose" BorderThickness="0" MaxHeight="150"
                    Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.View>
              <GridView>
                <GridViewColumn Header="Concepto" Width="320" DisplayMemberBinding="{Binding Concepto}" />
                <GridViewColumn Header="Monto" Width="100" DisplayMemberBinding="{Binding MontoFormateado}" />
              </GridView>
            </ListView.View>
          </ListView>
          <Separator Margin="0,8" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="130" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="6" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Subtotal" Margin="0,3" Foreground="#444" />
            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="txtSubtotal" Text="Bs 0.00"
                       TextAlignment="Right" Margin="0,3" Foreground="#444" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Honorario Nodus (10%)" Margin="0,3" Foreground="#444" />
            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="txtHonorario" Text="Bs 0.00"
                       TextAlignment="Right" Margin="0,3" Foreground="#444" />
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Descuento (Bs)" Margin="0,3"
                       VerticalAlignment="Center" Foreground="#444" />
            <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtDescuento" Text="0"
                     TextAlignment="Right" Padding="5,4" TextChanged="txtDescuento_TextChanged" />
            <Separator Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" />
            <TextBlock Grid.Row="4" Grid.Column="0" Text="TOTAL A PAGAR" FontWeight="Bold" FontSize="15" Margin="0,4" />
            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="txtTotalFinal" Text="Bs 0.00"
                       FontWeight="Bold" FontSize="15" TextAlignment="Right"
                       Foreground="{DynamicResource Color1}" Margin="0,4" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- Datos del Cliente -->
      <Border Grid.Row="2" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="6"
              Padding="12" Margin="0,0,0,12" Background="White">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                     Text="Datos del Cliente" FontWeight="Bold" FontSize="13"
                     Foreground="{DynamicResource Color1}" Margin="0,0,0,10" />
          <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,6,0">
            <TextBlock Text="Nombre *" FontSize="11" Margin="0,0,0,3" Foreground="#555" />
            <TextBox x:Name="txtClienteNombre" Padding="6,5" />
          </StackPanel>
          <StackPanel Grid.Row="1" Grid.Column="1" Margin="6,0,0,0">
            <TextBlock Text="Apellido *" FontSize="11" Margin="0,0,0,3" Foreground="#555" />
            <TextBox x:Name="txtClienteApellido" Padding="6,5" />
          </StackPanel>
          <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,8,6,0">
            <TextBlock Text="NIT o Carnet *" FontSize="11" Margin="0,0,0,3" Foreground="#555" />
            <TextBox x:Name="txtClienteNit" Padding="6,5" />
          </StackPanel>
          <StackPanel Grid.Row="2" Grid.Column="1" Margin="6,8,0,0">
            <TextBlock Text="Correo electronico" FontSize="11" Margin="0,0,0,3" Foreground="#555" />
            <TextBox x:Name="txtClienteCorreo" Padding="6,5" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- Metodo de Pago -->
      <StackPanel Grid.Row="3" Margin="0,0,0,10">
        <TextBlock Text="Metodo de Pago" FontWeight="SemiBold" Margin="0,0,0,8" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Button Content="Efectivo" x:Name="btnEfectivo" Grid.Column="0" Height="42"
                  Margin="0,0,5,0" Background="{DynamicResource Color2}"
                  Foreground="{DynamicResource Color4}" BorderBrush="{DynamicResource Color2}"
                  Click="btnEfectivo_Click" />
          <Button Content="QR" x:Name="btnQR" Grid.Column="1" Height="42"
                  Margin="5,0,0,0" Background="{DynamicResource Color2}"
                  Foreground="{DynamicResource Color4}" BorderBrush="{DynamicResource Color2}"
                  Click="btnQR_Click" />
        </Grid>
      </StackPanel>

      <!-- Panel Efectivo -->
      <Grid Grid.Row="4" x:Name="gridEfectivo" Visibility="Collapsed" Margin="0,0,0,10">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
          <TextBlock Text="Monto Recibido (Bs)" FontWeight="SemiBold" Margin="0,0,0,4" />
          <TextBox x:Name="txtMonto" Padding="6,5" IsReadOnly="True"/>
        </StackPanel>
        <StackPanel Grid.Row="1">
          <TextBlock Text="Nota (Opcional)" FontWeight="SemiBold" Margin="0,0,0,4" />
          <TextBox x:Name="txtNota" Height="55" Padding="6,5" TextWrapping="Wrap" AcceptsReturn="True" />
        </StackPanel>
      </Grid>

      <!-- Panel QR -->
      <Grid Grid.Row="4" x:Name="gridQR" Visibility="Collapsed" Margin="0,0,0,10">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Escanea el codigo QR para pagar" FontWeight="SemiBold" Margin="0,0,0,8" />
        <Image x:Name="imgCodigoQR" Grid.Row="1" Stretch="Uniform" MaxHeight="160" />
      </Grid>

      <!-- Botones -->
      <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
        <Button Content="Sin pago por ahora" x:Name="btnSinPago" Width="145" Height="36"
                Margin="0,0,10,0" Background="{DynamicResource Color2}"
                Foreground="{DynamicResource Color4}" BorderBrush="{DynamicResource Color2}"
                Click="btnSinPago_Click" />
        <Button Content="Confirmar Pago" x:Name="btnConfirmar" Width="135" Height="36"
                Background="{DynamicResource Color1}" Foreground="White"
                BorderBrush="{DynamicResource Color1}" Click="btnConfirmar_Click" />
      </StackPanel>
    </Grid>
  </ScrollViewer>
</Window>

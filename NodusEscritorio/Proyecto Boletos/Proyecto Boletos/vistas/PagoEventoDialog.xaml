<Window
  x:Class="Proyecto_Boletos.vistas.PagoEventoDialog"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="Confirmar Pago"
  Height="480"
  Width="420"
  WindowStartupLocation="CenterOwner"
  ResizeMode="NoResize"
  Icon="/Logo_Nodus.png"
>
  <Grid Margin="25">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock
      Grid.Row="0"
      Text="¿Desea realizar el pago ahora?"
      FontSize="16"
      FontWeight="Bold"
      Margin="0,0,0,15"
      Foreground="{DynamicResource Color1}"
    />

    <!-- Métodos de Pago -->
    <StackPanel Grid.Row="1" Margin="0,0,0,12">
      <TextBlock Text="Método de Pago" FontWeight="SemiBold" Margin="0,0,0,8" />
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Button
          Content="💵 Efectivo"
          x:Name="btnEfectivo"
          Grid.Column="0"
          Height="40"
          Margin="0,0,5,0"
          Background="{DynamicResource Color2}"
          Foreground="{DynamicResource Color4}"
          BorderBrush="{DynamicResource Color2}"
          Click="btnEfectivo_Click"
        />
        <Button
          Content="📱 QR"
          x:Name="btnQR"
          Grid.Column="1"
          Height="40"
          Margin="5,0,0,0"
          Background="{DynamicResource Color2}"
          Foreground="{DynamicResource Color4}"
          BorderBrush="{DynamicResource Color2}"
          Click="btnQR_Click"
        />
      </Grid>
    </StackPanel>

    <!-- Panel Efectivo -->
    <Grid Grid.Row="2" x:Name="gridEfectivo" Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0" Margin="0,0,0,12">
        <TextBlock Text="Monto (Bs)" FontWeight="SemiBold" Margin="0,0,0,4" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="40" />
          </Grid.ColumnDefinitions>
          <TextBox x:Name="txtMonto" Padding="6,5" IsEnabled="False"/>
          <TextBlock
            Grid.Column="1"
            Text="Bs"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            FontWeight="SemiBold"
          />
        </Grid>
      </StackPanel>

      <StackPanel Grid.Row="1" Margin="0,0,0,12">
        <TextBlock Text="Nota (Opcional)" FontWeight="SemiBold" Margin="0,0,0,4" />
        <TextBox
          x:Name="txtNota"
          Height="70"
          Padding="6,5"
          TextWrapping="Wrap"
          AcceptsReturn="True"
        />
      </StackPanel>
    </Grid>

    <!-- Panel QR -->
    <Grid Grid.Row="2" x:Name="gridQR" Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <TextBlock Text="Escanea el código QR para pagar" FontWeight="SemiBold" Margin="0,0,0,8" />
      <Image x:Name="imgCodigoQR" Grid.Row="1" Stretch="Uniform" MaxHeight="150" />
    </Grid>

    <!-- Botones -->
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
      <Button
        Content="Sin pago por ahora"
        x:Name="btnSinPago"
        Width="140"
        Height="36"
        Margin="0,0,10,0"
        Background="{DynamicResource Color2}"
        Foreground="{DynamicResource Color4}"
        BorderBrush="{DynamicResource Color2}"
        Click="btnSinPago_Click"
      />
      <Button
        Content="Confirmar Pago"
        x:Name="btnConfirmar"
        Width="130"
        Height="36"
        Background="{DynamicResource Color1}"
        Foreground="White"
        BorderBrush="{DynamicResource Color1}"
        Click="btnConfirmar_Click"
      />
    </StackPanel>
  </Grid>
</Window>

<Window
  x:Class="Proyecto_Boletos.vistas.MonitoreoWebView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="Monitoreo - Actividad Web"
  Height="640"
  Width="960"
  WindowStartupLocation="CenterOwner"
  ResizeMode="CanResizeWithGrip"
  Icon="/Logo_Nodus.png"
  Background="{DynamicResource Color3}"
  Loaded="Window_Loaded"
>
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Encabezado -->
    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
      <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE774;" FontSize="26"
                 Foreground="{DynamicResource Color1}" VerticalAlignment="Center" Margin="0,0,10,0" />
      <TextBlock Text="Monitoreo de Actividad Web"
                 FontSize="24" FontWeight="Bold" Foreground="{DynamicResource Color1}" />
      <Button x:Name="btnRefrescar" Content="  Actualizar" Height="32"
              Margin="20,0,0,0" Padding="10,0" Cursor="Hand"
              Background="{DynamicResource Color1}" Foreground="White"
              BorderBrush="{DynamicResource Color1}"
              Click="btnRefrescar_Click" />
    </StackPanel>

    <!-- Stats row -->
    <Grid Grid.Row="1" Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Margin="0,0,8,0" Padding="14,10"
              Background="White" BorderBrush="{DynamicResource Color1}" BorderThickness="1" CornerRadius="8">
        <StackPanel>
          <TextBlock Text="Usuarios Registrados" FontSize="12" Foreground="#555" />
          <TextBlock x:Name="txtWebUsuarios" Text="0" FontSize="32" FontWeight="Bold"
                     Foreground="{DynamicResource Color1}" />
        </StackPanel>
      </Border>

      <Border Grid.Column="1" Margin="8,0" Padding="14,10"
              Background="White" BorderBrush="{DynamicResource Color1}" BorderThickness="1" CornerRadius="8">
        <StackPanel>
          <TextBlock Text="Eventos Publicados" FontSize="12" Foreground="#555" />
          <TextBlock x:Name="txtWebEventos" Text="0" FontSize="32" FontWeight="Bold"
                     Foreground="{DynamicResource Color1}" />
        </StackPanel>
      </Border>

      <Border Grid.Column="2" Margin="8,0,0,0" Padding="14,10"
              Background="White" BorderBrush="{DynamicResource Color1}" BorderThickness="1" CornerRadius="8">
        <StackPanel>
          <TextBlock Text="Ordenes Recientes" FontSize="12" Foreground="#555" />
          <TextBlock x:Name="txtWebOrdenes" Text="0" FontSize="32" FontWeight="Bold"
                     Foreground="{DynamicResource Color4}" />
        </StackPanel>
      </Border>
    </Grid>

    <!-- Tablas -->
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Usuarios recientes -->
      <Border Grid.Column="0" Background="White"
              BorderBrush="{DynamicResource Color1}" BorderThickness="1" CornerRadius="8" Padding="14">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock Text="Usuarios Registrados" FontSize="15" FontWeight="Bold"
                     Foreground="{DynamicResource Color1}" Margin="0,0,0,10" />
          <DataGrid x:Name="dgWebUsuarios" Grid.Row="1"
                    AutoGenerateColumns="False" IsReadOnly="True"
                    HeadersVisibility="Column" GridLinesVisibility="None"
                    RowBackground="Transparent" Background="Transparent" BorderThickness="0" FontSize="12">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*" />
              <DataGridTextColumn Header="Correo" Binding="{Binding Correo}" Width="*" />
              <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="80" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>

      <!-- Ordenes recientes -->
      <Border Grid.Column="2" Background="White"
              BorderBrush="{DynamicResource Color1}" BorderThickness="1" CornerRadius="8" Padding="14">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock Text="Ordenes Recientes (Web)" FontSize="15" FontWeight="Bold"
                     Foreground="{DynamicResource Color1}" Margin="0,0,0,10" />
          <DataGrid x:Name="dgWebOrdenes" Grid.Row="1"
                    AutoGenerateColumns="False" IsReadOnly="True"
                    HeadersVisibility="Column" GridLinesVisibility="None"
                    RowBackground="Transparent" Background="Transparent" BorderThickness="0" FontSize="12">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha}" Width="110" />
              <DataGridTextColumn Header="Comprador" Binding="{Binding Comprador}" Width="*" />
              <DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="80" />
              <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="80" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>

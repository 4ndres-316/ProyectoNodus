<UserControl
  x:Class="Proyecto_Boletos.vistas.EventosView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  mc:Ignorable="d"
  d:DesignHeight="650"
  d:DesignWidth="950"
  Loaded="UserControl_Loaded"
>
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- TÍTULO -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Orientation="Horizontal" Margin="0 0 0 20">
        <TextBlock
          Text="Gestión de Eventos"
          FontSize="24"
          FontWeight="Bold"
          Foreground="{DynamicResource Color1}"
        />
        <TextBlock
          FontFamily="Segoe MDL2 Assets"
          Text="&#xE8D6;"
          FontSize="24"
          FontWeight="Bold"
          Foreground="{DynamicResource Color1}"
          Margin="10 5 0 0"
        />
      </StackPanel>

      <!-- Botones superiores -->
      <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0 0 0 20">
        <Button
          x:Name="btnIrReservas"
          Content="📋 Reservas"
          Width="120"
          Height="35"
          Margin="5"
          Background="{DynamicResource Color2}"
          Foreground="White"
          BorderBrush="{DynamicResource Color2}"
          Click="btnIrReservas_Click"
        />

        <Button
          x:Name="btnAgregarEvento"
          Content="➕ Agregar Evento"
          Width="140"
          Height="35"
          Margin="5"
          Background="{DynamicResource Color1}"
          Foreground="White"
          BorderBrush="{DynamicResource Color1}"
          Click="btnAgregarEvento_Click"
        />
      </StackPanel>
    </Grid>

    <!-- CALENDARIO -->
    <Border
      Grid.Row="1"
      BorderBrush="{DynamicResource Color1}"
      BorderThickness="1"
      CornerRadius="5"
      Margin="0,0,0,10"
    >
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="50" />
          <RowDefinition Height="40" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- NAVEGACIÓN MES -->
        <Grid Grid.Row="0" Background="{DynamicResource Color1}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="50" />
          </Grid.ColumnDefinitions>

          <Button
            x:Name="btnMesAnterior"
            Content="◀"
            Grid.Column="0"
            Background="Transparent"
            Foreground="White"
            BorderThickness="0"
            FontSize="16"
            Click="btnMesAnterior_Click"
          />

          <TextBlock
            x:Name="txtMesAnio"
            Grid.Column="1"
            Text="Mayo 2026"
            FontSize="18"
            FontWeight="Bold"
            Foreground="White"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
          />

          <Button
            x:Name="btnMesSiguiente"
            Content="▶"
            Grid.Column="2"
            Background="Transparent"
            Foreground="White"
            BorderThickness="0"
            FontSize="16"
            Click="btnMesSiguiente_Click"
          />
        </Grid>

        <!-- ENCABEZADOS DÍAS -->
        <UniformGrid Grid.Row="1" Columns="7" Background="#ECECEC">
          <TextBlock
            Text="DOM"
            FontWeight="Bold"
            FontSize="12"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="#555"
          />
          <TextBlock
            Text="LUN"
            FontWeight="Bold"
            FontSize="12"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="#555"
          />
          <TextBlock
            Text="MAR"
            FontWeight="Bold"
            FontSize="12"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="#555"
          />
          <TextBlock
            Text="MIÉ"
            FontWeight="Bold"
            FontSize="12"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="#555"
          />
          <TextBlock
            Text="JUE"
            FontWeight="Bold"
            FontSize="12"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="#555"
          />
          <TextBlock
            Text="VIE"
            FontWeight="Bold"
            FontSize="12"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="#555"
          />
          <TextBlock
            Text="SÁB"
            FontWeight="Bold"
            FontSize="12"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="#555"
          />
        </UniformGrid>

        <!-- CELDAS DEL CALENDARIO -->
        <UniformGrid x:Name="ugCalendario" Grid.Row="2" Columns="7" />
      </Grid>
    </Border>

    <!-- POPUP EVENTOS DEL DÍA -->
    <Popup
      x:Name="popupEventosDia"
      StaysOpen="False"
      AllowsTransparency="True"
      PopupAnimation="Fade"
    >
      <Border
        Background="{DynamicResource Color2}"
        BorderBrush="{DynamicResource Color3}"
        BorderThickness="1"
        CornerRadius="5"
        Padding="10"
        MinWidth="250"
        MaxWidth="350"
        Effect="{x:Null}"
      >
        <ScrollViewer VerticalScrollBarVisibility="Hidden" MaxHeight="400">
          <StackPanel>
            <TextBlock
              x:Name="txtPopupFecha"
              FontWeight="Bold"
              FontSize="14"
              Foreground="{DynamicResource Color1}"
              Margin="0,0,0,8"
            />
            <ItemsControl x:Name="lstPopupEventos">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="#E8F5EE" CornerRadius="3" Padding="8,5" Margin="0,3">
                    <StackPanel>
                      <TextBlock
                        Text="{Binding NombreEvento}"
                        FontWeight="SemiBold"
                        FontSize="13"
                      />

                      <TextBlock FontSize="12" Foreground="#555">
                        <Run Text="{Binding HoraEvento,StringFormat=hh\\:mm}" />
                        <Run Text=" → " />
                        <Run Text="{Binding HoraFin,StringFormat=hh\\:mm}" />
                        <Run Text=" — " />
                        <Run Text="{Binding NombreRecinto}" />
                      </TextBlock>

                      <TextBlock FontSize="11" Foreground="#888">
                        <Run Text="{Binding FechaEvento,StringFormat=dd/MM/yyyy}" />
                        <Run Text=" → " />
                        <Run Text="{Binding FechaFin,StringFormat=dd/MM/yyyy}" />
                      </TextBlock>

                      <TextBlock Text="{Binding Categoria}" FontSize="11" Foreground="#888" />

                      <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <Button
                          Content="Reprogramar"
                          Height="26"
                          Margin="0 3 3 0"
                          Padding="5 0"
                          Background="{DynamicResource Color1}"
                          Foreground="White"
                          BorderBrush="{DynamicResource Color1}"
                          Tag="{Binding}"
                        />
                        <Button
                          Content="Cancelar"
                          Height="26"
                          Margin="3 3 0 0"
                          Padding="10 0"
                          Background="#F44336"
                          Foreground="White"
                          BorderBrush="#F44336"
                          Tag="{Binding}"
                        />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock
              x:Name="txtSinEventos"
              Text="Sin eventos para este día"
              FontSize="12"
              Foreground="{DynamicResource Color4}"
              HorizontalAlignment="Center"
              Margin="0,5"
              Visibility="Collapsed"
            />
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Popup>
  </Grid>
</UserControl>

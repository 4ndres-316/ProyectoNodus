<UserControl
  x:Class="Proyecto_Boletos.vistas.ClientesView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  mc:Ignorable="d"
  d:DesignHeight="600" d:DesignWidth="900"
  Loaded="UserControl_Loaded"
>
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- TITULO -->
    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
      <TextBlock Text="Clientes" FontSize="26" FontWeight="Bold"
                 Foreground="{DynamicResource Color1}" />
      <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE77B;" FontSize="22"
                 Foreground="{DynamicResource Color1}" Margin="10,4,0,0" />
    </StackPanel>

    <!-- BARRA BUSQUEDA + NUEVO -->
    <Grid Grid.Row="1" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <Border BorderBrush="{DynamicResource Color1}" BorderThickness="1"
              CornerRadius="6" Background="White" Padding="10,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE721;" FontSize="16"
                     Foreground="#999" VerticalAlignment="Center" Margin="0,0,8,0" />
          <TextBox x:Name="txtBuscar" Grid.Column="1" BorderThickness="0"
                   Padding="0,8" FontSize="13" Background="Transparent"
                   TextChanged="txtBuscar_TextChanged"
                   Tag="Buscar por nombre, username o correo..." />
        </Grid>
      </Border>

      <Button Grid.Column="2" x:Name="btnNuevoCliente" Height="38" Padding="18,0"
              Background="{DynamicResource Color1}" Foreground="White"
              BorderBrush="{DynamicResource Color1}" FontSize="13" FontWeight="SemiBold"
              Cursor="Hand" Click="btnNuevoCliente_Click">
        <StackPanel Orientation="Horizontal">
          <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE710;" FontSize="14"
                     VerticalAlignment="Center" Margin="0,0,6,0" />
          <TextBlock Text="Nuevo Cliente" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </Grid>

    <!-- TABLA CLIENTES -->
    <Border Grid.Row="2" BorderBrush="{DynamicResource Color1}" BorderThickness="1"
            CornerRadius="8" Background="White" ClipToBounds="True">
      <ListView x:Name="lvClientes" BorderThickness="0" Background="Transparent">
        <ListView.View>
          <GridView>
            <GridViewColumn Header="Nombre" Width="180" DisplayMemberBinding="{Binding NombreUsuario}" />
            <GridViewColumn Header="Username" Width="120" DisplayMemberBinding="{Binding Username}" />
            <GridViewColumn Header="Correo" Width="200" DisplayMemberBinding="{Binding EmailUsuario}" />
            <GridViewColumn Header="Telefono" Width="110" DisplayMemberBinding="{Binding Telefono}" />
            <GridViewColumn Header="Estado" Width="90" DisplayMemberBinding="{Binding EstadoUsuario}" />
            <GridViewColumn Header="" Width="130">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <Button Content="Crear evento" Tag="{Binding}"
                          Height="26" Padding="8,0" FontSize="11"
                          Background="{DynamicResource Color1}" Foreground="White"
                          BorderBrush="{DynamicResource Color1}" Cursor="Hand"
                          Click="btnCrearEvento_Click" />
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="" Width="110">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <Button Content="Historial" Tag="{Binding}"
                          Height="26" Padding="8,0" FontSize="11"
                          Background="{DynamicResource Color2}" Foreground="White"
                          BorderBrush="{DynamicResource Color2}" Cursor="Hand"
                          Click="btnHistorial_Click" />
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
          </GridView>
        </ListView.View>
      </ListView>
    </Border>
  </Grid>
</UserControl>

<UserControl
  x:Class="Proyecto_Boletos.vistas.Configuracion"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="clr-namespace:Proyecto_Boletos.vistas"
  mc:Ignorable="d"
  d:DesignHeight="550"
  d:DesignWidth="850"
>
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="2*" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Título -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Orientation="Horizontal" Margin="0 0 0 20">
        <TextBlock
          Text="Gestión de Usuarios"
          FontSize="24"
          FontWeight="Bold"
          Foreground="{DynamicResource Color1}"
        />
        <TextBlock
          FontFamily="Segoe MDL2 Assets"
          Text="&#xE716;"
          FontSize="24"
          FontWeight="Bold"
          Foreground="{DynamicResource Color1}"
          Margin="10 5 0 0"
        />
      </StackPanel>

      <!-- Botones superiores -->
      <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0 0 0 20">
        <Button
          x:Name="btnNuevo"
          Content="Nuevo"
          Width="100"
          Height="35"
          Margin="5,0"
          Background="{DynamicResource Color1}"
          Foreground="White"
          BorderBrush="{DynamicResource Color1}"
          Click="btnNuevo_Click"
        />
        <Button
          x:Name="btnGuardar"
          Content="Guardar"
          Width="100"
          Height="35"
          Margin="5,0"
          Background="{DynamicResource Color1}"
          Foreground="White"
          BorderBrush="{DynamicResource Color1}"
          IsEnabled="False"
          Click="btnGuardar_Click"
        />
        <Button
          x:Name="btnCancelar"
          Content="Cancelar"
          Width="100"
          Height="35"
          Margin="5,0"
          Background="{DynamicResource Color2}"
          Foreground="White"
          BorderBrush="{DynamicResource Color2}"
          IsEnabled="False"
          Click="btnCancelar_Click"
        />
      </StackPanel>
    </Grid>

    <!-- Buscador -->
    <Border
      x:Name="buscador"
      Background="White"
      Grid.Row="1"
      Margin="0 0 0 20"
      BorderBrush="#CCCCCC"
      BorderThickness="1"
      CornerRadius="20"
    >
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="40" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock
          FontFamily="Segoe MDL2 Assets"
          Text="&#xE71E;"
          FontSize="20"
          Background="Transparent"
          VerticalAlignment="Center"
          HorizontalAlignment="Center"
        />
        <TextBox
          x:Name="txtBuscar"
          Grid.Column="1"
          Background="Transparent"
          BorderThickness="0"
          VerticalContentAlignment="Center"
          Margin="5 7"
          TextChanged="txtBuscar_TextChanged"
        />
      </Grid>
    </Border>

    <!-- DataGrid de usuarios -->
    <Border
      Grid.Row="2"
      BorderBrush="{DynamicResource Color1}"
      BorderThickness="1"
      CornerRadius="5"
      Margin="0,0,0,20"
    >
      <DataGrid
        x:Name="dgUsuarios"
        Style="{StaticResource ModernDataGridStyle}"
        SelectionChanged="dgUsuarios_SelectionChanged"
      >
        <DataGrid.Columns>
          <DataGridTextColumn
            Header="ID"
            Binding="{Binding IdUsuario}"
            Width="50"
            ElementStyle="{StaticResource TextoCentrado}"
          />
          <DataGridTextColumn
            Header="Nombre"
            Binding="{Binding NombreUsuario}"
            Width="2*"
            ElementStyle="{StaticResource TextoCentrado}"
          />
          <DataGridTextColumn
            Header="Email"
            Binding="{Binding EmailUsuario}"
            Width="2*"
            ElementStyle="{StaticResource TextoCentrado}"
          />
          <DataGridTextColumn
            Header="Teléfono"
            Binding="{Binding Telefono}"
            Width="*"
            ElementStyle="{StaticResource TextoCentrado}"
          />
          <DataGridTextColumn
            Header="Usuario"
            Binding="{Binding Username}"
            Width="120"
            ElementStyle="{StaticResource TextoCentrado}"
          />
          <DataGridTextColumn
            Header="Contraseña"
            Binding="{Binding Password}"
            Width="*"
            ElementStyle="{StaticResource TextoCentrado}"
          />
          <DataGridTextColumn
            Header="Rol"
            Binding="{Binding Rol.Nombre}"
            Width="100"
            ElementStyle="{StaticResource TextoCentrado}"
          />
          <DataGridTextColumn
            Header="Estado"
            Binding="{Binding EstadoUsuario}"
            Width="70"
            ElementStyle="{StaticResource TextoCentrado}"
          />
          <DataGridTemplateColumn Header="Opciones" Width="160">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                  <Button
                    Content="Editar"
                    Width="65"
                    Height="26"
                    Margin="3,0"
                    Background="{DynamicResource Color1}"
                    Foreground="White"
                    BorderBrush="{DynamicResource Color1}"
                    Tag="{Binding}"
                    Click="btnEditar_Click"
                  />
                  <Button
                    Content="Deshabilitar"
                    Height="26"
                    Margin="3,0"
                    Background="#F44336"
                    Foreground="White"
                    BorderBrush="#F44336"
                    Tag="{Binding}"
                    Click="btnEliminar_Click"
                  />
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </Border>

    <!-- Panel de formulario -->
    <Border
      Grid.Row="3"
      BorderBrush="{DynamicResource Color1}"
      BorderThickness="1"
      CornerRadius="5"
      Padding="10"
      Background="{DynamicResource Color3}"
    >
      <ScrollViewer VerticalScrollBarVisibility="Hidden">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Grid x:Name="campos" Grid.Row="0" IsEnabled="False">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Columna 1 -->
            <StackPanel Grid.Column="0" Margin="0,0,10,0">
              <TextBlock
                Text="Nombre Completo:"
                Margin="0,5"
                Foreground="{DynamicResource Color4}"
              />
              <TextBox x:Name="txtNombreUsuario" Padding="5" Margin="0,0,0,10" />

              <TextBlock Text="Email:" Margin="0,5" Foreground="{DynamicResource Color4}" />
              <TextBox x:Name="txtEmail" Padding="5" Margin="0,0,0,10" />

              <TextBlock
                x:Name="lblEstado"
                Text="Estado:"
                Margin="0,5"
                Foreground="{DynamicResource Color4}"
                Visibility="Collapsed"
              />
              <ComboBox x:Name="cmbEstado" Padding="5" Margin="0,0,0,10" Visibility="Collapsed">
                <ComboBoxItem Content="Activo" />
                <ComboBoxItem Content="Inactivo" />
              </ComboBox>
            </StackPanel>

            <!-- Columna 2 -->
            <StackPanel Grid.Column="1" Margin="10,0">
              <TextBlock
                Text="Usuario (Login):"
                Margin="0,5"
                Foreground="{DynamicResource Color4}"
              />
              <TextBox x:Name="txtUsername" Padding="5" Margin="0,0,0,10" />

              <TextBlock Text="Contraseña:" Margin="0,5" Foreground="{DynamicResource Color4}" />
              <TextBox x:Name="txtPassword" Padding="5" Margin="0,0,0,10" />
            </StackPanel>

            <!-- Columna 3 -->
            <StackPanel Grid.Column="2" Margin="10,0,0,0">
              <TextBlock Text="Teléfono:" Margin="0,5" Foreground="{DynamicResource Color4}" />
              <TextBox x:Name="txtTelefono" Padding="5" Margin="0,0,0,10" />

              <TextBlock Text="Rol:" Margin="0,5" Foreground="{DynamicResource Color4}" />
              <ComboBox
                x:Name="cmbRol"
                Padding="5"
                Margin="0,0,0,10"
                DisplayMemberPath="Nombre"
                SelectedValuePath="IdRol"
              />
            </StackPanel>
          </Grid>
        </Grid>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>

<UserControl
  x:Class="Proyecto_Boletos.vistas.DashboardView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  mc:Ignorable="d"
  d:DesignHeight="550"
  d:DesignWidth="850"
  Loaded="UserControl_Loaded"
>
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Orientation="Horizontal" Margin="0 0 0 20">
      <TextBlock
        Text="Dashboard General"
        FontSize="28"
        FontWeight="Bold"
        Foreground="{DynamicResource Color1}"
      />
      <TextBlock
        FontFamily="Segoe MDL2 Assets"
        Text="&#xF404;"
        FontSize="24"
        FontWeight="Bold"
        Foreground="{DynamicResource Color1}"
        Margin="10 5 0 0"
      />
    </StackPanel>

    <Grid Grid.Row="1" Margin="0,0,0,20">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border
        Grid.Column="0"
        Margin="5"
        Padding="15"
        Background="White"
        BorderBrush="{DynamicResource Color1}"
        BorderThickness="1"
        CornerRadius="10"
      >
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal">
            <TextBlock
              FontFamily="Segoe MDL2 Assets"
              Text="&#xE787;"
              FontSize="20"
              Foreground="{DynamicResource Color1}"
              VerticalAlignment="Center"
              Margin="0,0,10,0"
            />
            <TextBlock
              Text="Total Eventos"
              FontSize="16"
              Foreground="{DynamicResource Color1}"
              VerticalAlignment="Center"
            />
          </StackPanel>
          <TextBlock
            x:Name="txtTotalEventos"
            Grid.Row="1"
            Text="0"
            FontSize="42"
            FontWeight="Bold"
            Foreground="{DynamicResource Color1}"
            HorizontalAlignment="Left"
            Margin="0,10,0,0"
          />
        </Grid>
      </Border>

      <Border
        Grid.Column="1"
        Margin="5"
        Padding="15"
        Background="White"
        BorderBrush="{DynamicResource Color1}"
        BorderThickness="1"
        CornerRadius="10"
      >
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal">
            <TextBlock
              FontFamily="Segoe MDL2 Assets"
              Text="&#xE7C9;"
              FontSize="20"
              Foreground="{DynamicResource Color1}"
              VerticalAlignment="Center"
              Margin="0,0,10,0"
            />
            <TextBlock
              Text="Boletos Vendidos"
              FontSize="16"
              Foreground="{DynamicResource Color1}"
              VerticalAlignment="Center"
            />
          </StackPanel>
          <TextBlock
            x:Name="txtBoletosVendidos"
            Grid.Row="1"
            Text="0"
            FontSize="42"
            FontWeight="Bold"
            Foreground="{DynamicResource Color1}"
            HorizontalAlignment="Left"
            Margin="0,10,0,0"
          />
        </Grid>
      </Border>

      <Border
        Grid.Column="2"
        Margin="5"
        Padding="15"
        Background="White"
        BorderBrush="{DynamicResource Color1}"
        BorderThickness="1"
        CornerRadius="10"
      >
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal">
            <TextBlock
              FontFamily="Segoe MDL2 Assets"
              Text="&#xE107;"
              FontSize="20"
              Foreground="{DynamicResource Color1}"
              VerticalAlignment="Center"
              Margin="0,0,10,0"
            />
            <TextBlock
              Text="Ingresos Brutos"
              FontSize="16"
              Foreground="{DynamicResource Color1}"
              VerticalAlignment="Center"
            />
          </StackPanel>
          <TextBlock
            x:Name="txtIngresos"
            Grid.Row="1"
            Text="BS 0"
            FontSize="42"
            FontWeight="Bold"
            Foreground="#4CAF50"
            HorizontalAlignment="Left"
            Margin="0,10,0,0"
          />
        </Grid>
      </Border>

      <Border
        Grid.Column="3"
        Margin="5"
        Padding="15"
        Background="White"
        BorderBrush="{DynamicResource Color1}"
        BorderThickness="1"
        CornerRadius="10"
      >
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal">
            <TextBlock
              FontFamily="Segoe MDL2 Assets"
              Text="&#xE77B;"
              FontSize="20"
              Foreground="{DynamicResource Color1}"
              VerticalAlignment="Center"
              Margin="0,0,10,0"
            />
            <TextBlock
              Text="Usuarios Activos"
              FontSize="16"
              Foreground="{DynamicResource Color1}"
              VerticalAlignment="Center"
            />
          </StackPanel>
          <TextBlock
            x:Name="txtUsuariosActivos"
            Grid.Row="1"
            Text="0"
            FontSize="42"
            FontWeight="Bold"
            Foreground="{DynamicResource Color1}"
            HorizontalAlignment="Left"
            Margin="0,10,0,0"
          />
        </Grid>
      </Border>
    </Grid>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*" />
        <ColumnDefinition Width="1.5*" />
      </Grid.ColumnDefinitions>

      <Border
        Grid.Column="0"
        Margin="5"
        Background="White"
        BorderBrush="{DynamicResource Color1}"
        BorderThickness="1"
        CornerRadius="10"
        Padding="15"
      >
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock
            Text="Eventos Activos"
            FontSize="18"
            FontWeight="Bold"
            Foreground="{DynamicResource Color1}"
            Margin="0,0,0,15"
          />

          <DataGrid
            x:Name="dgProximosEventos"
            Grid.Row="1"
            AutoGenerateColumns="False"
            IsReadOnly="True"
            HeadersVisibility="Column"
            GridLinesVisibility="None"
            RowBackground="Transparent"
            Background="Transparent"
            BorderThickness="0"
          >
            <DataGrid.Columns>
              <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha}" Width="90" />
              <DataGridTextColumn Header="Hora" Binding="{Binding Hora}" Width="70" />
              <DataGridTextColumn Header="Evento" Binding="{Binding Nombre}" Width="*" />
              <DataGridTextColumn Header="Recinto" Binding="{Binding Recinto}" Width="*" />
              <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="90" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>

      <Border
        Grid.Column="1"
        Margin="5"
        Background="White"
        BorderBrush="{DynamicResource Color1}"
        BorderThickness="1"
        CornerRadius="10"
        Padding="15"
      >
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <TextBlock
            Text="Actividad de Ventas"
            FontSize="18"
            FontWeight="Bold"
            Foreground="{DynamicResource Color1}"
            Margin="0,0,0,15"
          />

          <DataGrid
            x:Name="dgVentas"
            Grid.Row="1"
            AutoGenerateColumns="False"
            IsReadOnly="True"
            HeadersVisibility="Column"
            GridLinesVisibility="None"
            RowBackground="Transparent"
            Background="Transparent"
            BorderThickness="0"
            FontSize="12"
          >
            <DataGrid.Columns>
              <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha}" Width="110" />
              <DataGridTextColumn Header="Evento" Binding="{Binding Evento}" Width="*" />
              <DataGridTextColumn Header="Tipo" Binding="{Binding TipoBoleto}" Width="70" />
              <DataGridTextColumn Header="Precio" Binding="{Binding Precio}" Width="70" />
              <DataGridTextColumn Header="Comprador" Binding="{Binding Comprador}" Width="*" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>

<UserControl
  x:Class="Proyecto_Boletos.vistas.ReportesView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  mc:Ignorable="d"
  d:DesignHeight="650"
  d:DesignWidth="950"
  Loaded="UserControl_Loaded"
>
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- TÍTULO -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
        <TextBlock
          Text="Generación de Reportes"
          FontSize="24"
          FontWeight="Bold"
          Foreground="{DynamicResource Color1}"
        />
        <TextBlock
          FontFamily="Segoe MDL2 Assets"
          Text="&#xE9F9;"
          FontSize="24"
          FontWeight="Bold"
          Foreground="{DynamicResource Color1}"
          Margin="10,5,0,0"
        />
      </StackPanel>
      <Button
        x:Name="btnExportar"
        Grid.Column="1"
        Content="🖨 Exportar / Imprimir"
        Height="34"
        Padding="14,0"
        VerticalAlignment="Top"
        Background="{DynamicResource Color1}"
        Foreground="White"
        BorderBrush="{DynamicResource Color1}"
        IsEnabled="False"
        Click="btnExportar_Click"
      />
    </Grid>

    <!-- FILTROS -->
    <Border
      Grid.Row="1"
      BorderBrush="{DynamicResource Color1}"
      BorderThickness="1"
      CornerRadius="5"
      Padding="10"
      Background="{DynamicResource Color3}"
      Margin="0,0,0,16"
    >
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,16,0">
          <TextBlock Text="Fecha Inicio:" Margin="0,0,0,5" Foreground="{DynamicResource Color4}" FontWeight="SemiBold" />
          <DatePicker x:Name="dpFechaInicio" Width="130" Padding="5" />
        </StackPanel>

        <StackPanel Grid.Column="1" Margin="0,0,16,0">
          <TextBlock Text="Fecha Fin:" Margin="0,0,0,5" Foreground="{DynamicResource Color4}" FontWeight="SemiBold" />
          <DatePicker x:Name="dpFechaFin" Width="130" Padding="5" />
        </StackPanel>

        <StackPanel Grid.Column="2" Margin="0,0,16,0">
          <TextBlock Text="Estado:" Margin="0,0,0,5" Foreground="{DynamicResource Color4}" FontWeight="SemiBold" />
          <ComboBox x:Name="cmbEstado" Width="130" Padding="5">
            <ComboBoxItem Content="Todos" IsSelected="True" />
            <ComboBoxItem Content="Programado" />
            <ComboBoxItem Content="Pagado" />
            <ComboBoxItem Content="En espera" />
            <ComboBoxItem Content="Reprogramado" />
            <ComboBoxItem Content="Cancelado" />
          </ComboBox>
        </StackPanel>

        <StackPanel Grid.Column="3" Margin="0,0,16,0">
          <TextBlock Text="Categoría:" Margin="0,0,0,5" Foreground="{DynamicResource Color4}" FontWeight="SemiBold" />
          <ComboBox x:Name="cmbCategoria" Width="150" Padding="5">
            <ComboBoxItem Content="Todas" IsSelected="True" />
            <ComboBoxItem Content="Concierto General" />
            <ComboBoxItem Content="Comida y Gastronomía" />
            <ComboBoxItem Content="Teatro y Artes Escénicas" />
            <ComboBoxItem Content="Deporte y Competición" />
            <ComboBoxItem Content="Conferencia / Seminario" />
            <ComboBoxItem Content="Festival de Música" />
            <ComboBoxItem Content="Stand-up Comedy" />
            <ComboBoxItem Content="Exposición de Arte" />
            <ComboBoxItem Content="Fiesta / Club / DJ" />
          </ComboBox>
        </StackPanel>

        <Button
          x:Name="btnGenerar"
          Grid.Column="4"
          Content="📊 Generar Reporte"
          Width="150"
          Height="35"
          HorizontalAlignment="Right"
          VerticalAlignment="Bottom"
          Background="{DynamicResource Color1}"
          Foreground="White"
          BorderBrush="{DynamicResource Color1}"
          Click="btnGenerar_Click"
        />
      </Grid>
    </Border>

    <!-- RESUMEN ESTADÍSTICO -->
    <UniformGrid
      x:Name="panelStats"
      Grid.Row="2"
      Columns="4"
      Margin="0,0,0,16"
      Visibility="Collapsed"
    >
      <!-- Card: Total Eventos -->
      <Border
        BorderBrush="{DynamicResource Color1}"
        BorderThickness="1"
        CornerRadius="8"
        Background="White"
        Margin="0,0,10,0"
        Padding="16,10"
      >
        <StackPanel>
          <TextBlock
            Text="Eventos en rango"
            FontSize="12"
            Foreground="Gray"
          />
          <TextBlock
            x:Name="txtStatEventos"
            Text="0"
            FontSize="30"
            FontWeight="Bold"
            Foreground="{DynamicResource Color1}"
          />
        </StackPanel>
      </Border>

      <!-- Card: Boletos Vendidos -->
      <Border
        BorderBrush="{DynamicResource Color1}"
        BorderThickness="1"
        CornerRadius="8"
        Background="White"
        Margin="0,0,10,0"
        Padding="16,10"
      >
        <StackPanel>
          <TextBlock
            Text="Boletos vendidos"
            FontSize="12"
            Foreground="Gray"
          />
          <TextBlock
            x:Name="txtStatBoletos"
            Text="0"
            FontSize="30"
            FontWeight="Bold"
            Foreground="{DynamicResource Color1}"
          />
        </StackPanel>
      </Border>

      <!-- Card: Total Recaudado -->
      <Border
        BorderBrush="{DynamicResource Color1}"
        BorderThickness="1"
        CornerRadius="8"
        Background="White"
        Margin="0,0,10,0"
        Padding="16,10"
      >
        <StackPanel>
          <TextBlock
            Text="Total recaudado"
            FontSize="12"
            Foreground="Gray"
          />
          <TextBlock
            x:Name="txtStatRecaudado"
            Text="Bs 0"
            FontSize="26"
            FontWeight="Bold"
            Foreground="{DynamicResource Color1}"
          />
        </StackPanel>
      </Border>

      <!-- Card: Cancelados -->
      <Border
        BorderBrush="#F44336"
        BorderThickness="1"
        CornerRadius="8"
        Background="White"
        Padding="16,10"
      >
        <StackPanel>
          <TextBlock
            Text="Cancelados"
            FontSize="12"
            Foreground="Gray"
          />
          <TextBlock
            x:Name="txtStatCancelados"
            Text="0"
            FontSize="30"
            FontWeight="Bold"
            Foreground="#F44336"
          />
        </StackPanel>
      </Border>
    </UniformGrid>

    <!-- TABLA DE RESULTADOS -->
    <Border
      Grid.Row="3"
      BorderBrush="{DynamicResource Color1}"
      BorderThickness="1"
      CornerRadius="5"
    >
      <Grid>
        <DataGrid
          x:Name="dgReportes"
          Style="{StaticResource ModernDataGridStyle}"
          AutoGenerateColumns="False"
          IsReadOnly="True"
          CanUserAddRows="False"
          SelectionMode="Single"
        >
          <DataGrid.Columns>
            <DataGridTextColumn
              Header="Nombre del Evento"
              Binding="{Binding NombreEvento}"
              Width="2*"
              ElementStyle="{StaticResource TextoCentrado}"
            />
            <DataGridTextColumn
              Header="Organizador"
              Binding="{Binding Organizador}"
              Width="*"
              ElementStyle="{StaticResource TextoCentrado}"
            />
            <DataGridTextColumn
              Header="Categoría"
              Binding="{Binding Categoria}"
              Width="120"
              ElementStyle="{StaticResource TextoCentrado}"
            />
            <DataGridTextColumn
              Header="Fecha Evento"
              Binding="{Binding FechaEvento}"
              Width="105"
              ElementStyle="{StaticResource TextoCentrado}"
            />
            <DataGridTextColumn
              Header="Estado"
              Binding="{Binding Estado}"
              Width="95"
              ElementStyle="{StaticResource TextoCentrado}"
            />
            <DataGridTextColumn
              Header="Boletos Vend."
              Binding="{Binding BoletosVendidos}"
              Width="90"
              ElementStyle="{StaticResource TextoCentrado}"
            />
            <DataGridTextColumn
              Header="Recaudado"
              Binding="{Binding TotalRecaudadoFormateado}"
              Width="100"
              ElementStyle="{StaticResource TextoCentrado}"
            />
            <DataGridTextColumn
              Header="Asistentes"
              Binding="{Binding Asistentes}"
              Width="80"
              ElementStyle="{StaticResource TextoCentrado}"
            />
          </DataGrid.Columns>
        </DataGrid>

        <!-- Placeholder inicial -->
        <StackPanel
          x:Name="pnlPlaceholder"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
        >
          <TextBlock
            FontFamily="Segoe MDL2 Assets"
            Text="&#xE9F9;"
            FontSize="48"
            Foreground="#DDD"
            HorizontalAlignment="Center"
          />
          <TextBlock
            Text="Selecciona un rango de fechas y genera el reporte"
            FontSize="13"
            Foreground="#AAA"
            HorizontalAlignment="Center"
            Margin="0,8,0,0"
          />
        </StackPanel>

        <!-- Cargando -->
        <TextBlock
          x:Name="txtCargando"
          Text="Generando reporte..."
          FontSize="14"
          Foreground="#999"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Visibility="Collapsed"
        />

        <!-- Sin datos -->
        <TextBlock
          x:Name="txtSinDatos"
          Text="No se encontraron eventos en el rango seleccionado."
          FontSize="14"
          Foreground="#999"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Visibility="Collapsed"
        />
      </Grid>
    </Border>
  </Grid>
</UserControl>

<UserControl
  x:Class="Proyecto_Boletos.vistas.RecintosView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  mc:Ignorable="d"
  d:DesignHeight="550"
  d:DesignWidth="850"
  Loaded="UserControl_Loaded"
>
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="2*" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- TÍTULO -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Orientation="Horizontal" Margin="0 0 0 20">
        <TextBlock
          Text="Gestión de Recintos"
          FontSize="24"
          FontWeight="Bold"
          Foreground="{DynamicResource Color1}"
        />
        <TextBlock
          FontFamily="Segoe MDL2 Assets"
          Text="&#xE731;"
          FontSize="24"
          FontWeight="Bold"
          Foreground="{DynamicResource Color1}"
          Margin="10 5 0 0"
        />
      </StackPanel>

      <!-- Botones superiores -->
      <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0 0 0 20">
        <Button
          x:Name="btnNuevo"
          Content="Nuevo"
          Width="100"
          Height="35"
          Margin="5,0"
          Background="{DynamicResource Color1}"
          Foreground="White"
          BorderBrush="{DynamicResource Color1}"
          Click="btnNuevo_Click"
        />
        <Button
          x:Name="btnGuardar"
          Content="Guardar"
          Width="100"
          Height="35"
          Margin="5,0"
          Background="{DynamicResource Color1}"
          Foreground="White"
          BorderBrush="{DynamicResource Color1}"
          IsEnabled="False"
          Click="btnGuardar_Click"
        />
        <Button
          x:Name="btnCancelar"
          Content="Cancelar"
          Width="100"
          Height="35"
          Margin="5,0"
          Background="{DynamicResource Color2}"
          Foreground="White"
          BorderBrush="{DynamicResource Color2}"
          IsEnabled="False"
          Click="btnCancelar_Click"
        />
      </StackPanel>
    </Grid>

    <!-- Buscador -->
    <Border
      x:Name="buscador"
      Background="White"
      Grid.Row="1"
      Margin="0 0 0 20"
      BorderBrush="#CCCCCC"
      BorderThickness="1"
      CornerRadius="20"
    >
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="40" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock
          FontFamily="Segoe MDL2 Assets"
          Text="&#xE71E;"
          FontSize="20"
          Background="Transparent"
          VerticalAlignment="Center"
          HorizontalAlignment="Center"
        />
        <TextBox
          x:Name="txtBuscar"
          Grid.Column="1"
          Background="Transparent"
          BorderThickness="0"
          VerticalContentAlignment="Center"
          Margin="5 7"
          TextChanged="txtBuscar_TextChanged"
        />
      </Grid>
    </Border>

    <!-- DATAGRID -->
    <Border
      Grid.Row="2"
      BorderBrush="{DynamicResource Color1}"
      BorderThickness="1"
      CornerRadius="5"
      Margin="0,0,0,20"
    >
      <DataGrid
        x:Name="dgRecintos"
        Style="{StaticResource ModernDataGridStyle}"
        SelectionChanged="dgRecintos_SelectionChanged"
      >
        <!-- COLUMNAS -->
        <DataGrid.Columns>
          <DataGridTextColumn
            Header="ID"
            Binding="{Binding IdRecinto}"
            Width="50"
            ElementStyle="{StaticResource TextoCentrado}"
          />

          <DataGridTextColumn
            Header="Ciudad"
            Binding="{Binding NombreCiudad}"
            Width="*"
            ElementStyle="{StaticResource TextoCentrado}"
          />

          <DataGridTextColumn
            Header="Nombre"
            Binding="{Binding NombreRecinto}"
            Width="*"
            ElementStyle="{StaticResource TextoCentrado}"
          />

          <DataGridTextColumn
            Header="Tipo"
            Binding="{Binding TipoRecinto}"
            Width="*"
            ElementStyle="{StaticResource TextoCentrado}"
          />

          <DataGridTextColumn
            Header="Capacidad"
            Binding="{Binding Capacidad}"
            Width="120"
            ElementStyle="{StaticResource TextoCentrado}"
          />

          <DataGridTextColumn
            Header="Precio/Hora"
            Binding="{Binding PrecioHora}"
            Width="*"
            ElementStyle="{StaticResource TextoCentrado}"
          />

          <DataGridTextColumn
            Header="Estado"
            Binding="{Binding EstadoRecinto}"
            Width="120"
            ElementStyle="{StaticResource TextoCentrado}"
          />

          <DataGridTemplateColumn Header="Opciones" Width="160">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                  <Button
                    Content="Editar"
                    Width="65"
                    Height="26"
                    Margin="3,0"
                    Background="{DynamicResource Color1}"
                    Foreground="White"
                    BorderBrush="{DynamicResource Color1}"
                    Tag="{Binding}"
                    Click="btnEditar_Click"
                  />
                  <Button
                    Content="Deshabilitar"
                    Height="26"
                    Margin="3,0"
                    Background="#F44336"
                    Foreground="White"
                    BorderBrush="#F44336"
                    Tag="{Binding}"
                  />
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </Border>

    <!-- FORMULARIO -->
    <Border
      Grid.Row="3"
      BorderBrush="{DynamicResource Color1}"
      BorderThickness="1"
      CornerRadius="5"
      Padding="10"
      Background="{DynamicResource Color3}"
    >
      <ScrollViewer VerticalScrollBarVisibility="Hidden">
        <!-- CAMPOS -->
        <Grid x:Name="campos" Grid.Row="0" IsEnabled="False">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- FILA 1 -->
          <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,0">
            <TextBlock
              Text="Nombre del Recinto:"
              Margin="0,5"
              Foreground="{DynamicResource Color4}"
            />

            <TextBox x:Name="txtNombreRecinto" Padding="5" Margin="0,0,0,10" />
          </StackPanel>

          <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,10,0">
            <TextBlock
              Text="Dirección Completa:"
              Margin="0,5"
              Foreground="{DynamicResource Color4}"
            />

            <TextBox x:Name="txtDireccion" Padding="5" Margin="0,0,0,10" />
          </StackPanel>

          <StackPanel Grid.Row="0" Grid.Column="2" Margin="10,0,0,0">
            <TextBlock Text="Ciudad:" Margin="0,5" Foreground="{DynamicResource Color4}" />
            <ComboBox x:Name="cmbIdCiudad" Padding="5" Margin="0,0,0,10" />
          </StackPanel>

          <!-- FILA 2 -->
          <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,0">
            <TextBlock Text="Tipo de Recinto:" Margin="0,5" Foreground="{DynamicResource Color4}" />

            <ComboBox x:Name="cmbTipoRecinto" Padding="5" Margin="0,0,0,10">
              <ComboBoxItem Content="Teatro" IsSelected="True" />
              <ComboBoxItem Content="Estadio" />
              <ComboBoxItem Content="Auditorio" />
              <ComboBoxItem Content="Al aire libre" />
              <ComboBoxItem Content="Coliseo" />
              <ComboBoxItem Content="Centro de Convenciones" />
              <ComboBoxItem Content="Otro" />
            </ComboBox>
          </StackPanel>

          <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,10,0">
            <TextBlock
              Text="Precio por Hora (Bs):"
              Margin="0,5"
              Foreground="{DynamicResource Color4}"
            />
            <TextBox x:Name="txtPrecioHora" Padding="5" Margin="0,0,0,10" />
          </StackPanel>

          <StackPanel Grid.Row="1" Grid.Column="2" Margin="10,0,0,0">
            <TextBlock
              Text="Capacidad Máxima:"
              Margin="0,5"
              Foreground="{DynamicResource Color4}"
            />

            <TextBox x:Name="txtCapacidad" Padding="5" Margin="0,0,0,10" />
          </StackPanel>

          <!-- FILA 3 -->
          <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,10,0">
            <TextBlock Text="Estado:" Margin="0,5" Foreground="{DynamicResource Color4}" />
            <ComboBox x:Name="cmbEstadoRecinto" Padding="5" Margin="0,0,0,10">
              <ComboBoxItem Content="Disponible" IsSelected="True" />
              <ComboBoxItem Content="En Mantenimiento" />
              <ComboBoxItem Content="Clausurado" />
            </ComboBox>
          </StackPanel>

          <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="10,0,0,0">
            <TextBlock Text="URL Dirección:" Margin="0,5" Foreground="{DynamicResource Color4}" />
            <TextBox x:Name="txtUrlDireccion" Padding="5" Margin="0,0,0,10" />
          </StackPanel>

          <!-- FILA 4 -->
          <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3">
            <TextBlock
              Text="Descripción / Notas:"
              Margin="0,5"
              Foreground="{DynamicResource Color4}"
            />

            <TextBox
              x:Name="txtDescripcion"
              Padding="5"
              Height="50"
              TextWrapping="Wrap"
              AcceptsReturn="True"
            />
          </StackPanel>
        </Grid>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>

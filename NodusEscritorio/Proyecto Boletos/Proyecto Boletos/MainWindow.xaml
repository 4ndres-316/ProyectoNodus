<Window
  x:Class="Proyecto_Boletos.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:local="clr-namespace:Proyecto_Boletos"
  mc:Ignorable="d"
  Title="Login Cliente - Nodus"
  Height="550"
  Width="950"
  WindowStartupLocation="CenterScreen"
  Background="{DynamicResource Color3}"
  Icon="/Logo_Nodus.png"
  FontFamily="Segoe UI"
  ResizeMode="NoResize"
>
  <Grid Background="#F5F7FA">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="1.2*" />
      <ColumnDefinition Width="1*" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Margin="0 0 0 0">
      <Grid>
        <Image Source="{DynamicResource imgActual}" Stretch="UniformToFill" Opacity="1" />
        <TextBlock
          x:Name="titulo"
          Text="NODUS"
          FontSize="40"
          FontWeight="ExtraBold"
          VerticalAlignment="Top"
          HorizontalAlignment="Left"
          Margin="30,30,0,0"
          Foreground="{DynamicResource TituloActual}"
        />
      </Grid>
    </Border>

    <Grid Grid.Column="1" Background="{DynamicResource Color2}">
      <Border
        Background="White"
        CornerRadius="20"
        Margin="40,20,40,20"
        Padding="30,20,30,20"
        VerticalAlignment="Center"
      >
        <Border.Effect>
          <DropShadowEffect BlurRadius="25" ShadowDepth="4" Color="#333333" Opacity="0.15" />
        </Border.Effect>

        <StackPanel>
          <Image
            Source="/Logo_Nodus.png"
            Width="80"
            Height="80"
            Margin="0,0,0,5"
            Stretch="Uniform"
          />
          <StackPanel Margin="0,5,0,0">
            <TextBlock Text="Usuario" Margin="0,5,0,2" Foreground="#555555" FontSize="13" />
            <Border
              BorderBrush="#CCCCCC"
              BorderThickness="1"
              CornerRadius="8"
              Height="40"
              Background="#F9F9F9"
            >
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="40" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                  Text="&#xE77B;"
                  FontFamily="Segoe MDL2 Assets"
                  FontSize="16"
                  Foreground="#888888"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Center"
                />
                <TextBox
                  x:Name="tbUser"
                  Grid.Column="1"
                  Background="Transparent"
                  BorderThickness="0"
                  VerticalContentAlignment="Center"
                  FontSize="14"
                />
              </Grid>
            </Border>

            <TextBlock Text="Contraseña" Margin="0,10,0,2" Foreground="#555555" FontSize="13" />
            <Border
              BorderBrush="#CCCCCC"
              BorderThickness="1"
              CornerRadius="8"
              Height="40"
              Background="#F9F9F9"
            >
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="40" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="40" />
                </Grid.ColumnDefinitions>

                <!-- Icono -->
                <TextBlock
                  Text="&#xE72E;"
                  FontFamily="Segoe MDL2 Assets"
                  FontSize="16"
                  Foreground="#888888"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Center"
                />

                <!-- PasswordBox -->
                <PasswordBox
                  x:Name="pbPassword"
                  Grid.Column="1"
                  Background="Transparent"
                  BorderThickness="0"
                  VerticalContentAlignment="Center"
                  FontSize="14"
                />

                <!-- TextBox para mostrar contraseña -->
                <TextBox
                  x:Name="txtPassword"
                  Grid.Column="1"
                  Background="Transparent"
                  BorderThickness="0"
                  VerticalContentAlignment="Center"
                  FontSize="14"
                  Visibility="Collapsed"
                />

                <!-- Botón mostrar/ocultar -->
                <Button
                  x:Name="btnMostrar"
                  Grid.Column="2"
                  Background="Transparent"
                  BorderThickness="0"
                  Cursor="Hand"
                  Click="btnMostrar_Click"
                >
                  <TextBlock
                    x:Name="iconoOjo"
                    Text="&#xE890;"
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="16"
                    Foreground="#888888"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                  />
                </Button>
              </Grid>
            </Border>

            <Button
              x:Name="btnLogin"
              Content="Ingresar"
              Margin="0,15,0,10"
              Height="40"
              Background="{DynamicResource Color1}"
              Foreground="White"
              FontSize="15"
              FontWeight="Bold"
              BorderThickness="0"
              IsDefault="True"
              Cursor="Hand"
              Click="btnLogin_Click"
            >
              <Button.Resources>
                <Style TargetType="Border">
                  <Setter Property="CornerRadius" Value="8" />
                </Style>
              </Button.Resources>
            </Button>

            <Button
              x:Name="btnSalir1"
              Content="Salir"
              Height="40"
              Margin="0,0,0,5"
              Background="{DynamicResource Color1}"
              Foreground="White"
              FontSize="15"
              FontWeight="SemiBold"
              BorderThickness="0"
              IsCancel="True"
              Cursor="Hand"
              Click="btnSalir_Click"
            >
              <Button.Resources>
                <Style TargetType="Border">
                  <Setter Property="CornerRadius" Value="8" />
                </Style>
              </Button.Resources>
            </Button>
          </StackPanel>
        </StackPanel>
      </Border>

      <Button
        x:Name="btnCambio"
        HorizontalAlignment="Right"
        VerticalAlignment="Bottom"
        Margin="0,0,20,20"
        Width="50"
        Height="50"
        Background="White"
        Cursor="Hand"
        Click="btnCambio_Click"
        BorderThickness="0"
      >
        <Button.Template>
          <ControlTemplate TargetType="Button">
            <Border Background="{DynamicResource Color2}" CornerRadius="25">
              <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="5" Opacity="0.3" />
              </Border.Effect>
              <TextBlock
                FontFamily="Segoe MDL2 Assets"
                Text="{DynamicResource txtActual}"
                FontSize="35"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Foreground="{DynamicResource Color4}"
              />
            </Border>
          </ControlTemplate>
        </Button.Template>
      </Button>
    </Grid>
  </Grid>
</Window>
